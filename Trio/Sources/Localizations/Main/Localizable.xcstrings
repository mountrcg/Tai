    "This feature ensures more accurate insulin adjustments when carb entries are missing or incorrect." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This feature ensures more accurate insulin adjustments when carb entries are missing or incorrect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne funktion sikrer mere nøjagtige insulinjusteringer, når carb poster mangler eller er forkerte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Einstellung sorgt für genauere Insulinanpassungen, wenn Kohlenhydrateingaben fehlen oder nicht korrekt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta característica asegura ajustes de insulina más precisos cuando las entradas de glúcido faltan o son incorrectas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fonctionnalité permet des ajustements d’insuline plus précis lorsqu’il n’y a pas d’ajouts de glucides ou qu’ils sont incorrects."
          }
        },
        "he" : {
          "stringUnit" : {
