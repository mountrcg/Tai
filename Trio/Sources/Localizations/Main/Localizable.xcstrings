    "The Half Basal Exercise Target allows you to scale down your basal insulin during exercise or scale up your basal insulin when eating soon when a temporary glucose target is set." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Half Basal Exercise Target allows you to scale down your basal insulin during exercise or scale up your basal insulin when eating soon when a temporary glucose target is set."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half Basal Exercise Target giver dig mulighed for at reducere din basal insulin under motion eller skalere din basal insulin, når du spiser hurtigt, når et midlertidigt glucosemål er indstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Halb-Basal-Sport-Ziel kannst Du Dein Basalinsulin während des Trainings herabsetzen oder Dein Basalinsulin beim Essen erhöhen, wenn ein vorübergehendes Glukoseziel festgelegt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Objetivo de Ejercicio Basal de la mitad le permite reducir su insulina basal durante el ejercicio o aumentar su insulina basal al comer pronto cuando se establece un objetivo temporal de glucosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réglage « Cible à demi-basal » permet de réduire le débit basal pendant l’exercice, ou de l’augmenter avant un repas proche, lorsqu’une Cible Temporaire est définie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Half Basal Exercise Target allows you to scale down your basal insulin during exercise or scale up your basal insulin when eating soon when a temporary glucose target is set."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Half Basal Exercise Target le permette di ridimensionare l’insulina basale durante l’esercizio fisico o di aumentare l’insulina basale quando si mangia presto quando viene fissato un obiettivo temporaneo di glucosio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Half Basal Exercise Target allows you to scale down your basal insulin during exercise or scale up your basal insulin when eating soon when a temporary glucose target is set."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målverdi for halv basal ved trening tillater å skalere ned basalinsulin ved trening eller skalere opp basalinsulin når du snart skal spise, dersom et midlertidig mål er satt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De \"Halve-Basaal Sportdoel\" kun je je basale insuline verlagen tijdens het sporten, of je basale insuline verhogen als je binnenkort gaat eten, wanneer een tijdelijk glucose-streefdoel is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb ćwiczeń umożliwia zmniejszenie dawki insuliny bazowej podczas wysiłku fizycznego lub zwiększenie dawki insuliny bazowej podczas posiłku wkrótce po ustaleniu tymczasowego docelowego poziomu glukozy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Alvo de Exercício Basal Meia permite que você redimensione sua insulina basal durante exercícios ou redimensione sua insulina basal quando estiver comendo em breve quando um alvo de glicose temporário estiver definido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Halva basaldosen vid motionsläge' gör att du kan minska ditt basalinsulin under träning, eller öka ditt basalinsulin när du äter snart om ett tillfälligt glukosmål aktiveras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Half Basal Exercise Target allows you to scale down your basal insulin during exercise or scale up your basal insulin when eating soon when a temporary glucose target is set."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напівбазальна ціль дозволяє зменшити ваші базові інсуліни під час вправи або збільшити свій базовий інсулін, коли з’їдять найближчим часом, коли буде встановлено тимчасову ціль глюкози."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục tiêu tập luyện cơ bản một nửa cho phép bạn giảm lượng insulin cơ bản trong khi tập luyện hoặc tăng lượng insulin cơ bản khi ăn sớm khi mục tiêu đường huyết tạm thời được thiết lập."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半基礎運動目標允許您在運動期間減少基礎胰島素，或在臨時目標設置的情況下趕快進餐時提高基礎胰島素。"
          }
        }
      }
    },
