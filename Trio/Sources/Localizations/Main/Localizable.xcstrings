          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si utilizza la formula Sigmoid, la dose giornaliera totale ponderata ha un impatto molto inferiore sugli aggiustamenti dinamici della sensibilità."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using the Sigmoid Formula, the weighted Total Daily Dose has a much lower impact on the dynamic adjustments to sensitivity."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når man bruker sigmoidformelen, har den vektede totale daglige dosen en mye lavere innvirkning på de dynamiske justeringene av sensitivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij gebruik van de Sigmoid Formule heeft de gewogen Totale Dagelijkse Dose een veel lagere impact op de dynamische aanpassingen van de gevoeligheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku stosowania wzoru na Sigmoid ważona całkowita dawka dobowa ma znacznie mniejszy wpływ na dynamiczne dostosowanie wrażliwości."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
