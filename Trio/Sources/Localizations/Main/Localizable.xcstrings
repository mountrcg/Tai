    },
    "Enabling SMB Always will disable some of the subsequent \"Enable SMB\" options during Onboarding. These redundant options will be skipped." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling SMB Always will disable some of the subsequent \"Enable SMB\" options during Onboarding. These redundant options will be skipped."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering af SMB Altid vil deaktivere nogle af de efterfølgende \"Aktiver SMB\" indstillinger under Onboarding. Disse overflødige indstillinger vil blive sprunget over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn 'SMB immer' aktiviert wird, werden untergeordnete 'Aktiviere SMB' Optionen in den Einstellungen deaktiviert und übersprungen."
