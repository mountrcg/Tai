        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio ne collecte ni ne suit aucune donnée d’utilisation ni autre donnée personnelle concernant les utilisateurs, à l’exception du modèle d’iPhone utilisé et de la version d’iOS."
          }
