    "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carb Ratios dækker 24 timer. Du kan ikke tilføje flere priser. Fjern eller juster eksisterende priser for at gøre plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CRs decken 24 Stunden ab. Sau kannst nicht mehr CRs hinzufügen. Bitte entferne oder ändere die bestehenden CRs, um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los índices de carbohidratos cubren 24 horas. No puedes añadir más tarifas. Por favor, elimina o ajusta las tarifas existentes para hacer espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Ratios Insuline/Glucides couvrent déjà 24 heures. Vous ne pouvez pas en ajouter un autre. Veuillez en supprimer un ou ajuster ceux existants pour libérer de l’espace."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I rapporti Carb coprono 24 ore. Non è possibile aggiungere più tasse. Si prega di rimuovere o modificare le tariffe esistenti per fare spazio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karbo-rater dekker 24 timer. Du kan ikke legge til flere rater. Vennligst fjern eller juster eksisterende rater for å lage plass til en ny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koolhydraten verhoudingen beslaan 24 uur. U kunt niet meer tarieven toevoegen. Verwijder of pas bestaande tarieven aan om ruimte te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współczynniki węglowodanów obejmują 24 godziny. Nie można dodać więcej dawek. Proszę usunąć lub dostosować istniejące dawki, aby zrobić miejsce."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de Carb cobre 24 horas. Você não pode adicionar mais taxas. Por favor, remova ou ajuste as taxas existentes para liberar espaço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulinkvoter täcker 24 timmar. Du kan inte lägga till fler poster. Ta bort eller justera befintliga poster för att göra utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коефіцієнт Карба охоплює 24 години. Ви не можете додати більше ставок. Будь ласка, видаліть або відрегулюйте тарифи, щоб створити місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tỷ lệ Carb bao gồm 24 giờ. Bạn không thể thêm nhiều mức tỷ lệ hơn. Vui lòng xóa hoặc điều chỉnh các mức tỷ lệ hiện tại để tạo chỗ trống."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "碳水化合物比例涵蓋 24 小時。您無法添加更多速率。請移除或調整現有的速率以騰出空間。"
          }
        }
      }
    },
