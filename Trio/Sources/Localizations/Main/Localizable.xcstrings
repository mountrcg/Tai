        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio is still fully functional and will adapt quickly — but your awareness right now helps it keep you safer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio is still fully functional and will adapt quickly — but your awareness right now helps it keep you safer."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio er fortsatt fullt funksjonell og vil tilpasse seg raskt - men du burde følge ekstra med en stund for å holde deg tryggere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio is nog steeds functioneel en zal zich snel aanpassen - maar je oplettendheid nu helpt je het veiliger te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
