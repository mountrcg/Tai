          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These two settings determine the range outside of which you will be notified via push notifications."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці два налаштування визначають діапазон поза яким ви будете отримувати через push-сповіщення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai cài đặt này xác định phạm vi mà bạn sẽ nhận được thông báo qua thông báo đẩy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這兩個設定決定您將透過推播通知知曉的範圍。"
          }
        }
