    "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App diagnostisk indsigt hjælper os med at forbedre appstabiliteten, sikre sikkerheden for alle brugere og gøre det muligt for os hurtigt at identificere og løse kritiske problemer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erkenntnisse aus der App-Diagnose helfen uns, die Stabilität der App zu verbessern, die Sicherheit für alle Nutzer zu gewährleisten und kritische Probleme schnell zu erkennen und zu beheben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de diagnostic de l’app nous aident à améliorer sa stabilité, garantir la sécurité de tous les utilisateurs et nous permettent d’identifier rapidement les problèmes critiques pour les résoudre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-diagnoseinnsikt hjelper oss med å forbedre appstabiliteten, sikre sikkerhet for alle brukere og gjør oss i stand til raskt å identifisere og løse kritiske problemer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appdiagnostische inzichten helpen ons om de app-stabiliteit te verbeteren, de veiligheid voor alle gebruikers te waarborgen en ons in staat te stellen kritieke problemen snel te identificeren en op te lossen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Informacje diagnostyczne pomagają nam zwiększyć stabilność aplikacji, zagwarantować bezpieczeństwo wszystkim użytkownikom oraz umożliwić szybką identyfikację i rozwiązywanie krytycznych problemów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appdiagnostiska insikter hjälper oss att förbättra appens stabilitet, skapa en säker användning för alla användare, och göra det möjligt för oss att snabbt identifiera och lösa kritiska problem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App diagnostic insights help us enhance app stability, ensure safety for all users, and enable us to quickly identify and resolve critical issues."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông tin chi tiết về chẩn đoán ứng dụng giúp chúng tôi nâng cao tính ổn định của ứng dụng, đảm bảo an toàn cho mọi người dùng và cho phép chúng tôi nhanh chóng xác định và giải quyết các vấn đề quan trọng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式診斷見解幫助我們提升應用程式穩定性，確保所有使用者的安全，並使我們能夠迅速識別和解決關鍵問題。"
          }
        }
      }
    },
