          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le réglage « Toujours activer SMB » lors de la configuration initiale (onboarding), désactivera certaines des options « Activer SMB ...» suivantes. Ces options redondantes seront ignorées."
          }
        },
        "he" : {
