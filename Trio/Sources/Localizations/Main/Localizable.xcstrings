    "Tracks the carbohydrates you eat, entered to guide insulin dosing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tracks the carbohydrates you eat, entered to guide insulin dosing."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måler de kulhydrater, De spiser, og som kan vejlede insulindosis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgt die von Dir gegessenen Kohlenhydrate, die zur Steuerung der Insulindosierung eingegeben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir los hidratos de carbono que usted come, entró para guiar la dosis de insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signale les glucides que vous avez consommés et enregistrés, pour servir de base au dosage d’insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tracks the carbohydrates you eat, entered to guide insulin dosing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia i carboidrati che mangia, inseriti per guidare la somministrazione di insulina."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tracks the carbohydrates you eat, entered to guide insulin dosing."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser karbohydratene du har registrert gjennom boluskalkulator eller karbohydratregistrering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volgt de koolhydraten die je eet, ingevoerd om insuline te doven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledzi spożywane węglowodany, wprowadzone do zalecanego dawkowania insuliny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
