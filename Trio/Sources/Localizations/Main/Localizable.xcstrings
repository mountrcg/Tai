          }
        }
      }
    },
    "If you attempt to request a bolus larger than this, the bolus will not be accepted." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you attempt to request a bolus larger than this, the bolus will not be accepted."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du forsøger at anmode om en bolus større end dette, vil bolus ikke blive accepteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Du versuchst einen Bolus anzufordern, der größer als dieser Wert ist, wird der Bolus nicht akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si usted intenta solicitar un bolo más grande que esto, el bolo no será aceptado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous essayez d’administrer un bolus supérieur à cette valeur, il sera refusé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you attempt to request a bolus larger than this, the bolus will not be accepted."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se si tenta di richiedere un bolo più grande di questo, il bolo non sarà accettato."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you attempt to request a bolus larger than this, the bolus will not be accepted."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dersom du prøver å gi en bolus større enn dette, vil bolusen ikke bli gitt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je probeert een bolus groter dan dit op te vragen, zal de bolus niet worden geaccepteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli spróbujesz poprosić o bolus większy niż ten, bolus nie zostanie zaakceptowany."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tentar pedir um bolus maior do que este, o bolus não será aceite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du försöker ge en större bolus än detta, kommer bolusen inte att accepteras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you attempt to request a bolus larger than this, the bolus will not be accepted."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви спробуєте запросити болс більший, ніж цей, то болт не буде прийнятий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn cố gắng yêu cầu một lượng bolus lớn hơn mức này, lượng bolus đó sẽ không được chấp nhận."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您嘗試請求的注射量大於此，該注射將不被接受。"
          }
        }
      }
    },
