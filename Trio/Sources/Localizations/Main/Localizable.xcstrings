          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente la glucosa es de color rojo sólo cuando está por encima o debajo de sus límites de notificación para alto/bajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalement, la mesure de glucose n’est colorée en rouge que lorsqu’elle dépasse la limite de notification haute ou basse"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
