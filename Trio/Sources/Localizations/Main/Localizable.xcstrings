          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви не бачите календарі, які потрібно вибрати, будь ласка, перейдіть до Налаштування -> Тріо -> Календарі і змініть дозволи на \"Повний доступ\""
          }
        },
        "vi" : {
          "stringUnit" : {
