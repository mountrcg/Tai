        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt er glukose kun farvet rødt, når over eller under din anmeldelse grænser for høj/lav"
          }
        },
        "de" : {
          "stringUnit" : {
