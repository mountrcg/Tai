    "If you prefer not to share this anonymized data, you can opt-out of data sharing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you prefer not to share this anonymized data, you can opt-out of data sharing."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du foretrækker ikke at dele disse anonymiserede data, kan du fravælge datadeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Du es vorziehst, diese anonymisierten Daten nicht weiterzugeben, kannst Du die Datenweitergabe ablehnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you prefer not to share this anonymized data, you can opt-out of data sharing."
          }
