          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio consente di creare automazioni utilizzando le scorciatoie iOS. Vai all'app Scorciatoie per creare nuove automazioni."
          }
        },
        "ko" : {
