    "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sætter den maksimale længde af tid, fedt og protein kulhydrater (FPU'er) vil blive forlænget over fra en enkelt fedt og/eller protein bolus calcultor indgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier wird die maximale Zeitspanne festgelegt, über die Fett- und Eiweiß-Kohlenhydrat-Äquivalente (FPUs) aus einem einzelnen Fett- und/oder Eiweißbolus-Rechnereintrag verteilt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto establece la duración máxima de tiempo que Equivalentes de Carbohidratos de Grasa y Proteína (FPUs) se extenderán desde una sola entrada de calculadora de Grasa y/o Proteína."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit la durée maximale sur laquelle les équivalents glucidiques des lipides et protéines (FPU) seront répartis à partir d’un seul ajout de lipides et/ou protéines dans le calculateur de bolus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo imposta il tempo massimo in cui gli equivalenti di Carb di Grasso e Proteina (FPUs) saranno estesi da una singola voce di calcultore in bolo di Grasso e/o Proteine."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette angir den maksimale tidsrammen for fordeling av fett- og proteiner (FPU) for hver måltidsregistrering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt de maximale tijdsduur van Fat en Protein koolhydraat Equivalenten (FPU's) verlengd met een enkele vet- en/of Protein boluscalculator."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia to maksymalną długość czasu, w którym równoważniki tłuszczu i węglowodanów białkowych (FPU) zostaną przedłużone z pojedynczego kalkulatora tłuszczów i/lub białka."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto define o período máximo de tempo que o equivalente a Gorduras e proteínas Carb (EFP) será alargado a partir de uma única entrada de cultivo de bólus e/ou proteínas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta anger den maximala tidslängden som kolhydratekvivalenter från fett- och protein (FPU) kommer att fördelas över efter en enskild måltidsregistrering med fett och/eller protein."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це встановлює максимальну тривалість часу, коли Пат і Protein Carb Equivalent (ФPU) будуть продовжені з одного Fat та/або бронебійного акаунта."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này thiết lập khoảng thời gian tối đa mà các giá trị chất béo và chất đạm tương đương carb (FPU) sẽ được kéo dài từ một mục nhập tính toán lượng chất béo và/hoặc chất đạm duy nhất."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
