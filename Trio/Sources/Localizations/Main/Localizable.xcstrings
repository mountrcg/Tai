            "state" : "new",
            "value" : "This Temp Target preset is currently running. Deleting will stop it."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette forhåndsinnstilte midlertidige målet kjører. Sletting vil stoppe det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
