    "The degree to which your glucose should be rising or falling based solely on insulin activity." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The degree to which your glucose should be rising or falling based solely on insulin activity."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det omfang af Deres glukose bør stige eller falde udelukkende på grund af insulinaktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Grad in dem Deine Glukose ansteigen oder fallen sollte, nur aufgrund der Insulinaktivität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El grado en el que su glucosa debería estar aumentando o cayendo basándose únicamente en la actividad de la insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ampleur avec laquelle la mesure de glucose devrait monter ou descendre uniquement en fonction de l’activité de l’insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The degree to which your glucose should be rising or falling based solely on insulin activity."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il grado in cui il glucosio deve aumentare o diminuire in base esclusivamente all’attività insulinica."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The degree to which your glucose should be rising or falling based solely on insulin activity."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hvilken grad blodsukkeret burde stige eller synke, basert utelukkende på insulinaktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De mate waarin je glucose moet stijgen of dalen, uitsluitend gebaseerd op de insuline activiteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopień wzrostu lub spadku stężenia glikemii zależy wyłącznie od aktywności insuliny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O grau em que sua glicose deveria estar crescendo ou caindo exclusivamente baseado na atividade insulina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förkortning för 'Blodglukoseffekt' (Blood Glucose Impact). Den grad som ditt glukos borde öka eller falla enbart baserat på insulinaktivitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The degree to which your glucose should be rising or falling based solely on insulin activity."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Студент, до якого ваша глюкоза піднімається або ґрунтується виключно на активності інсуліну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức độ tăng hoặc giảm lượng đường huyết của bạn chỉ dựa trên hoạt động của insulin."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據胰島素活動，您的血糖應該上升或下降的程度。"
          }
        }
      }
    },
    "The Detailed Lock Screen Widget offers users a glucose chart as well as the ability to customize the information provided in the Detailed Widget using the following options:" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Detailed Lock Screen Widget offers users a glucose chart as well as the ability to customize the information provided in the Detailed Widget using the following options:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den detaljerede låseskærm widget tilbyder brugerne et glukosediagram samt evnen til at tilpasse oplysningerne i den detaljerede widget ved hjælp af følgende indstillinger:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das detaillierte Sperrbildschirm-Widget bietet den Benutzern ein Glucose-Diagramm sowie die Möglichkeit, die im Detail-Widget bereitgestellten Informationen mit den folgenden Optionen anzupassen:"
