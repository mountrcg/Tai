        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Gedetailleerde Lock Screen Widget biedt gebruikers een glucose grafiek en de mogelijkheid om de informatie in de Gedetailleerde Widget aan te passen met behulp van de volgende opties:"
