          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo ISF corretto è temporaneo, cambierà con il ciclo di ciclo successivo e non dovrebbe essere utilizzato direttamente come valore ISF del tuo profilo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This adjusted ISF is temporary, will change with the next loop cycle, and should not be directly used as your profile ISF value."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne justerte ISF-verdien er midlertidig og vil endres ved neste Loop-syklus. Den bør ikke benyttes som fasit for insulinfølsomhet i din profil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit aangepaste ISF is tijdelijk en zal veranderen met de volgende luscyclus, en zou niet direct als ISF-waarde moeten worden gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To skorygowane ISF jest tymczasowe, zmieni się z następnym cyklem pętli i nie powinno być bezpośrednio używane jako wartość ISF Twojego profilu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ISF ajustado é temporário, irá mudar com o próximo ciclo de laços, e não deve ser usado diretamente como seu valor ISF de perfil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna justerade ISF är tillfällig, och kommer att justeras vid nästa loopcykel, och bör inte användas direkt som ditt profil ISF-värde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This adjusted ISF is temporary, will change with the next loop cycle, and should not be directly used as your profile ISF value."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей налаштований провайдер тимчасовий, буде змінюватися з наступним циклом циклу і не повинен безпосередньо використовуватися як ваше значення профілю ISF."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ISF đã điều chỉnh này chỉ là tạm thời, sẽ thay đổi theo chu kỳ lặp tiếp theo và không nên được sử dụng trực tiếp làm giá trị cấu hình ISF của bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此調整的ISF為臨時性，將在下一個循環週期中更改，且不應直接用作您的個人設定ISF值。"
          }
        }
      }
    },
