        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: denne må settes høyere enn 0 for at Trio skal kunne dosere insulin automatisk gjennom midlertidige basalrater eller SMB."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwing: Dit moet groter zijn dan 0 om eventuele automatische tijdelijke basaalstanden of SMB toe te kennen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie: Ta wartość musi być większa od 0, aby można było podać jakiekolwiek automatyczne tymczasowe dawki podstawowe lub SMB."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: Isto deve ser superior a 0 para que quaisquer taxas basais temporárias automáticas ou SMBs sejam dadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning: Detta värde måste vara större än 0 för att temporärt ökad basal och/eller SMBs ska kunna ges."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: This must be greater than 0 for any automatic temporary basal rates or SMBs to be given."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередження: це має бути більше 0 для будь-яких автоматичних тимчасових базових ставок або SMS для використання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo: Giá trị này phải lớn hơn 0 để bất kỳ mức tỷ lệ cơ bản tạm thời tự động nào hoặc SMB được đưa ra."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：這必須大於0，任何自動臨時基礎速率或SMBs才能生效。"
          }
        }
      }
    },
