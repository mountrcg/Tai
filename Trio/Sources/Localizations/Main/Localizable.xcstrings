    "It allows you to refer to live information at a glance and perform quick actions in your diabetes management." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det giver dig mulighed for at henvise til levende information på et overblik og udføre hurtige handlinger i din diabetes management."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ermöglicht es Dir, aktuelle Informationen auf einen Blick abzurufen und schnelle Maßnahmen für Dein Diabetesmanagement durchzuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le permite referirse a la información en vivo de un vistazo y realizar acciones rápidas en el manejo de su diabetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela permet de consulter les informations en direct d’un simple coup d’œil et d’effectuer des actions rapides pour la gestion de votre diabète."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti permette di fare riferimento alle informazioni dal vivo a colpo d'occhio ed eseguire azioni rapide nella gestione del diabete."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lar deg se oppdatert informasjon ved et øyekast og gjøre raske vurderinger av din diabetesbehandling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het stelt u in staat om live informatie te raadplegen en snelle acties uit te voeren in uw diabetesbeheer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala to na zapoznanie się z informacjami na żywo i na szybką reakcję w leczeniu cukrzycy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele permite que você se refira a informações ao vivo rapidamente e execute ações rápidas no seu gerenciamento de diabetes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gör att du kan se aktuell information på ett ögonblick och utföra snabba åtgärder i din diabetesbehandling."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона дозволяє посилатися на пряму інформацію уважно, здійснюючи швидкі дії з управління діабетами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép bạn tham khảo thông tin trực tiếp ngay lập tức và thực hiện các hành động nhanh chóng trong việc kiểm soát bệnh tiểu đường của bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可以讓你一目了然地參考即時資訊，並在糖尿病管理中執行快速操作。"
          }
        }
      }
    },
    "It is not recommended to set Autosens Max above 150% to maintain safe insulin dosing." : {
      "localizations" : {
