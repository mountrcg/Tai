          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio lar deg lage automatisering med iOS-snarveier. Gå til Snarvei-appen for å lage nye automatiseringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Trio kun je automatiseringen maken met behulp van iOS Snelkoppelingen. Ga naar de app Snelkoppelingen om nieuwe automaties te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
