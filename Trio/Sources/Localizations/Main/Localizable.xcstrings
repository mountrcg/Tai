    "These two settings determine the range outside of which you will be notified via push notifications." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These two settings determine the range outside of which you will be notified via push notifications."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse to indstillinger afgør området udenfor hvilket du vil blive underrettet via push-notifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese beiden Einstellungen bestimmen den Bereich, außerhalb dessen Du über Push-Benachrichtigungen informiert wirst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos dos ajustes determinan el rango fuera del cual se te notificará a través de notificaciones push."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces deux réglages définissent la plage en dehors de laquelle vous recevrez une notification push."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These two settings determine the range outside of which you will be notified via push notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste due impostazioni determinano l'intervallo al di fuori del quale verrai avvisato tramite notifiche push."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These two settings determine the range outside of which you will be notified via push notifications."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse to innstillingene bestemmer området utenfor hvilket du vil bli varslet via push-varsler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze twee instellingen bepalen het bereik buiten waarvan u een melding krijgt via push-meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te dwa ustawienia określają zakres, poza którym będziesz powiadamiany za pomocą powiadomień push."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
