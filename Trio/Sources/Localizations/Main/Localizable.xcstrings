    "Setting this to 100% means only the past 24 hours will be used." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Setting this to 100% means only the past 24 hours will be used."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstilling af dette til 100% betyder kun de sidste 24 timer vil blive brugt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn man diese Einstellung auf 100% setzt, bedeutet dies, dass nur die letzten 24 Stunden verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer esto al 100% significa que sólo se usarán las últimas 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définir cette valeur à 100 % signifie que seules les dernières 24 heures seront prises en compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Setting this to 100% means only the past 24 hours will be used."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostare questo al 100% significa che solo le ultime 24 ore saranno utilizzate."
          }
        },
        "ko" : {
