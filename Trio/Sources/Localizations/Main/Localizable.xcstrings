          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ретельне налаштування має важливе значення для уникнення надмірно агресивних змін інсуліну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc điều chỉnh cẩn thận là điều cần thiết để tránh những thay đổi insulin quá mức."
