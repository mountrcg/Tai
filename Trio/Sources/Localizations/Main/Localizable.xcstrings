            "value" : "Nếu bạn không thấy lịch để chọn ở đây, vui lòng vào Cài đặt -> Trio -> Lịch và thay đổi quyền thành \"Truy cập đầy đủ\""
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
