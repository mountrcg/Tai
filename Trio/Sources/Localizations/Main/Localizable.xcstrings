          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При використанні формули сигмоїди, зважена Загальна доза має значно менший вплив на динамічні корективи до чутливості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi sử dụng Công thức Sigmoid, Tổng liều hàng ngày có trọng số có tác động thấp hơn nhiều đến sự điều chỉnh động đối với độ nhạy."
          }
        },
        "zh-Hant" : {
