    "Swipe left to delete a single entry. Tap on it, to edit its time or rate." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to delete a single entry. Tap on it, to edit its time or rate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til venstre for at slette en enkelt post. Tryk på den, for at redigere dens tid eller hastighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach links, um einen einzelnen Eintrag zu löschen. Tippe darauf, um seine Zeit oder Rate zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslice a la izquierda para eliminar una sola entrada. Pulse en ella, para editar su tiempo o calificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour supprimer un ajout. Touchez-le pour modifier son heure ou sa valeur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to delete a single entry. Tap on it, to edit its time or rate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra per eliminare una singola voce. Toccarla, per modificarne il tempo o la velocità."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to delete a single entry. Tap on it, to edit its time or rate."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til venstre for å slette en oppføring. Trykk for å redigere tid eller rate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om een enkele invoer te verwijderen. Tik erop om de tijd of koers te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcem w lewo, aby usunąć pojedynczy wpis. Dotknij go, aby edytować czas lub dawkę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para excluir uma única entrada. Toque nela, para editar seu tempo ou tarifa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt vänster för att ta bort en enskild post. Tryck på den för att redigera dess tid eller mängd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to delete a single entry. Tap on it, to edit its time or rate."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть пальцем ліворуч, щоб видалити один запис. Натисніть на нього, щоб змінити його час чи частоту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt sang trái để xóa một mục nhập. Chạm vào mục đó để chỉnh sửa thời gian hoặc tốc độ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左滑動以刪除單一紀錄。點擊它以編輯其時間或速率。"
          }
        }
      }
    },
    "Swipe left to edit or delete a temporary target preset. Hold, drag and drop to reorder a preset." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to edit or delete a temporary target preset. Hold, drag and drop to reorder a preset."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til venstre for at redigere eller slette et midlertidigt mål forudindstilling. Hold, træk og slip for at ændre en forudindstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach links wischen, um eine Temporäre Ziel-Vorlage zu bearbeiten oder zu löschen. Halten, ziehen und Ablegen, um eine Vorlage neu zu ordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para editar o eliminar un preset de destino temporal. Mantén, arrastra y suelta para reordenar un preset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour modifier ou supprimer une Cible Temporaire favorite. Maintenez, faites glisser et déposez pour en réorganiser une."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to edit or delete a temporary target preset. Hold, drag and drop to reorder a preset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra per modificare o eliminare una preimpostazione di destinazione temporanea. Tieni, trascina e rilascia per riordinare una preimpostazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to edit or delete a temporary target preset. Hold, drag and drop to reorder a preset."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til venstre for å redigere eller slette en forhåndsinnstilling. Hold, dra og slipp for å endre rekkefølgen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om een tijdelijke doelvoorinstelling te bewerken of te verwijderen. Houd vast en sleep om een voorinstelling opnieuw te ordenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcem w lewo, aby edytować lub usunąć tymczasowe ustawienie docelowe. Przytrzymaj, przeciągnij i upuść, aby zmienić kolejność ustawień."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para editar ou excluir uma predefinição de destino temporário. Segure, arraste e solte para reordenar uma predefinição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt vänster för att redigera eller ta bort ett tillfälligt mål-förval. Håll, dra och släpp för att ändra ordning i listan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to edit or delete a temporary target preset. Hold, drag and drop to reorder a preset."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свайпніть ліворуч, щоб змінити або видалити тимчасовий цільовий пресет. Перетягніть і скиньте його щоб змінити порядок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt sang trái để chỉnh sửa hoặc xóa mục tiêu cài đặt trước tạm thời. Giữ, kéo và thả để sắp xếp lại mục tiêu cài đặt trước."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左滑動以編輯或刪除臨時目標預設。長按、拖曳並放下以重新排序預設。"
          }
        }
      }
    },
