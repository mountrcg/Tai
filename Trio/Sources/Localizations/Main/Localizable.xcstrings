    "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har fuldført onboarding, vises et rødt banner på Trios hovedskærm for at guide dig til iOS-indstillinger, hvor du kan aktivere notifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Abschluss des Einrichtungsvorgangs wird auf dem Hauptbildschirm von Trio ein rotes Banner angezeigt, das Dich zur iOS-Einstellungs-App führt, in der Du Benachrichtigungen aktivieren kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois le parcours de configuration initiale terminée, une bannière rouge s’affichera sur l’écran principal de Trio pour vous guider vers l’app Réglages d’iOS, où vous pourrez activer les notifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er ferdig med veiledningen, vil det vises en rød banner på hovedskjermen i Trio. Den vil ta deg til iOS Innstillinger, der du kan aktivere varslinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na het voltooien van onboarding, verschijnt er een rode banner op het hoofdscherm van Trio, om u te begeleiden naar de iOS instellingen app, waar u meldingen kunt inschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zakończeniu wdrażania na ekranie głównym Trio pojawi się czerwony baner, który poprowadzi Cię do aplikacji Ustawienia iOS, gdzie możesz włączyć powiadomienia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du har avslutat onboardingen visas en röd banner på Trios huvudskärm som leder dig till iOS-inställningarna, där du kan aktivera aviseringar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After completing onboarding, a red banner will appear on Trio's main screen to guide you to the iOS Settings app, where you can enable notifications."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi hoàn tất quá trình hướng dẫn, một biểu ngữ màu đỏ sẽ xuất hiện trên màn hình chính của Trio để hướng dẫn bạn đến ứng dụng Cài đặt iOS, nơi bạn có thể bật thông báo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成註冊後，Tri o的主螢幕上會出現紅色橫幅，指引您前往 iOS 設定應用程式，以啟用通知。"
          }
        }
      }
    },
