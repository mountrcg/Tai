        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli są aktywne węglowodany (COB > 0), włączenie tej funkcji pozwala Trio na stosowanie Super Micro Bolusów (SMB) w celu dostarczenia wymaganej dawki insuliny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When there are carbs on board (COB > 0), enabling this feature allows Trio to use Super Micro Boluses (SMB) to deliver the insulin required."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När denna funktion är aktiverad kan Trio använda supermikrobolusar (SMB) för att leverera insulin när det finns aktiva kolhydrater (COB)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When there are carbs on board (COB > 0), enabling this feature allows Trio to use Super Micro Boluses (SMB) to deliver the insulin required."
          }
        },
        "uk" : {
