          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att sätta detta till 100% betyder att bara de senaste 24 timmarna kommer att användas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
