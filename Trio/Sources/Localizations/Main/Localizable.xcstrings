          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установка цього значення на 100% означає тільки за останні 24 години."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt thành 100% nghĩa là chỉ sử dụng dữ liệu của 24 giờ trước đó."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此設置為 100% 意味著僅使用過去 24 小時的數據。"
          }
        }
      }
    },
