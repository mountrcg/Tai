          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dersom blodsukkermålet er %1$@ %2$@, vil Trio bruke en sikkerhetsterskel på %3$@ %4$@, med mindre du setter minste sikkerhetsterskel til en verdi > %5$@ %6$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je glucose doel %1$@ %2$@is, gebruikt Trio een veiligheidsdrempel van %3$@ %4$@, tenzij je minimale veiligheidsdrempel ingesteld hebt op iets > %5$@ %6$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli twój cel glukozy jest %1$@ %2$@Trio użyje progu bezpieczeństwa %3$@ %4$@, chyba że ustawisz minimalny próg bezpieczeństwa na coś > %5$@ %6$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
