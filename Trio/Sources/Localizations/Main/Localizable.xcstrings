    },
    "This adjusted ISF is temporary, will change with the next loop cycle, and should not be directly used as your profile ISF value." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This adjusted ISF is temporary, will change with the next loop cycle, and should not be directly used as your profile ISF value."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne justerede ISF er midlertidig, vil ændre sig med den næste loop cyklus, og bør ikke bruges direkte som din profil ISF værdi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser angepasste ISF ist temporär, wird sich mit dem nächsten Loop ändern und sollte nicht direkt als ISF-Wert für Dein Profil verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ISF ajustado es temporal, cambiará con el siguiente ciclo de bucle, y no debe ser utilizado directamente como el valor ISF de tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
