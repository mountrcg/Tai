    "Diagnostics are sent to a Google Firebase Crashlytics project, which is securely maintained and accessed only by the Trio team." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Diagnostics are sent to a Google Firebase Crashlytics project, which is securely maintained and accessed only by the Trio team."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostik sendes til et Google Firebase Crashlytics projekt, som kun vedligeholdes og tilgås af Trio-holdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Diagnosen werden an ein Google Firebase Crashlytics-Projekt gesendet, das sicher verwaltet wird und auf das nur das Trio-Team Zugriff hat."
          }
        },
        "es" : {
