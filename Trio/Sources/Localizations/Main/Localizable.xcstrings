          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Trio nie gromadzi żadnych danych dotyczących zdrowia, np. odczytów poziomu glukozy, wskaźników i dawek insuliny, danych o posiłkach, wartości ustawień itp."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
