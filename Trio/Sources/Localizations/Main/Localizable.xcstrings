    "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal profil dækker 24 timer. Du kan ikke tilføje flere priser. Fjern eller juster eksisterende priser for at gøre plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Basalprofil umfasst 24 Stunden. Du kannst nicht mehr Raten hinzufügen. Bitte entferne oder ändere bestehende Basalraten, um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil basal cubre 24 horas. No puede añadir más tasas. Por favor, elimine o ajuste las tarifas existentes para hacer espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil basal couvre l’ensemble des 24 heures. Vous ne pouvez pas ajouter d’autres débits. Veuillez supprimer ou ajuster les débits existants pour libérer de l’espace."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo basale copre 24 ore. Non è possibile aggiungere più tasse. Si prega di rimuovere o modificare le tariffe esistenti per fare spazio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basalprofilen dekker allerede 24 timer. Du kan ikke legge til flere rater. Vennligst fjern eller juster eksisterende rater for å lage plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basaal profiel betreft 24 uur. Je kunt niet meer profielen toevoegen. Verwijder of pas bestaande tarieven aan om ruimte te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawka podstawowa obejmuje 24 godziny. Nie można dodać więcej dawek. Proszę usunąć lub dostosować istniejące dawki, aby zrobić miejsce."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil Basal abrange 24 horas. Você não pode adicionar mais taxas. Remova ou ajuste as taxas existentes para liberar espaço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basalprofil täcker 24 timmar. Du kan inte lägga till fler poster. Ta bort eller justera befintliga poster för att skapa utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основний профіль охоплює 24 години. Ви не можете додати більше ставок. Будь ласка, видаліть або відрегулюйте тарифи, щоб створити місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal profile bao gồm 24 giờ. Bạn không thể thêm nhiều mức hơn. Vui lòng xóa hoặc điều chỉnh các mức hiện có để tạo khoảng trống."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基礎設定涵蓋24小時。你不能增加更多速率。請移除或調整現有的速率以騰出空間。"
          }
        }
      }
    },
