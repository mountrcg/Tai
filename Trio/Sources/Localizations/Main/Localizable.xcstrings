    "Enabling this feature allows Trio to deliver insulin required using Super Micro Boluses (SMB) at times when a manual Temporary Target under %@ %@ is set." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this feature allows Trio to deliver insulin required using Super Micro Boluses (SMB) at times when a manual Temporary Target under %1$@ %2$@ is set."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering af denne funktion gør det muligt for Trio at levere den insulin, der kræves ved hjælp af Super Micro Boluses (SMB) på tidspunkter, hvor et manuelt midlertidigt mål under %1$@ %2$@ er indstillet."
          }
        },
        "de" : {
          "stringUnit" : {
