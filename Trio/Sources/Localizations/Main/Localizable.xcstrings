        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering af denne funktion gør det muligt for Trio at levere den ønskede insulin ved hjælp af Super Micro Boluses (SMB) i 6 timer efter en carb post, uanset om der er aktive kulhydrater om bord (COB)."
          }
        },
        "de" : {
