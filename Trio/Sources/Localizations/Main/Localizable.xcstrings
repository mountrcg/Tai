    "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mål adfærd giver dig mulighed for at justere, hvordan midlertidige mål påvirker ISF, basal, og auto-målretning baseret på følsomhed eller modstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Zielverhalten kannst Du einstellen, wie Temporäre Ziele den ISF, die Basalrate und die Auto-Zielanpassung auf der Grundlage von Empfindlichkeit oder Resistenz beeinflussen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le comportement de la cible permet d’ajuster la manière dont les cibles temporaires influencent l’ISF (facteur de sensibilité à l'insuline), le basal et l'ajustement automatique de la cible en fonction de la sensibilité ou de la résistance à l'insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måloppførselen gjør det mulig å justere hvordan midlertidige mål påvirker ISF, basal og automatisk mål basert på følsomhet eller resistens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doelgedrag stelt je in staat om aan te passen hoe tijdelijke doelen invloed hebben op ISF, basaal en auto-doelwit gebaseerd op gevoeligheid of weerstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcja Zachowanie celu umożliwia dostosowanie sposobu, w jaki cele tymczasowe wpływają na ISF, bazę i automatyczne celowanie w oparciu o wrażliwość lub odporność."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med målbeteende kan du justera hur tillfälliga mål påverkar ISF, basal, och automatisk måljustering baserad på känslighet eller resistens."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Behavior allows you to adjust how temporary targets influence ISF, basal, and auto-targeting based on sensitivity or resistance."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử lý mục tiêu cho phép bạn điều chỉnh cách các mục tiêu tạm thời ảnh hưởng đến ISF, mục tiêu cơ bản và mục tiêu tự động dựa trên độ nhạy hoặc sức đề kháng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標行為允許您調整臨時目標對 ISF、基礎和自動目標的影響，根據敏感度或抵抗力進行調整。"
          }
        }
      }
    },
