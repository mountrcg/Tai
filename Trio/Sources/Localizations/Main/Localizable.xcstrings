    "Note: A CGM is considered noisy when it provides inconsistent readings." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: A CGM is considered noisy when it provides inconsistent readings."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Et CGM betragtes som støjende, når det giver inkonsekvente aflæsninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Ein CGM gilt als verrauscht, wenn es inkonsistente Messwerte liefert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Un CGM se considera ruidoso cuando proporciona lecturas inconsistentes."
