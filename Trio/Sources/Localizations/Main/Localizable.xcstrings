          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je deze geanonimiseerde gegevens liever niet deelt, kun je ervoor kiezen het delen van gegevens niet toe te staan."
          }
        },
        "pl" : {
          "stringUnit" : {
