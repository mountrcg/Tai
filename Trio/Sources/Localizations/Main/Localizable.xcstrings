          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente il glucosio è colorato rosso solo quando sopra o sotto i limiti di notifica per alto/basso"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
