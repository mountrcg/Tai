          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio reste entièrement fonctionnel et s’adaptera rapidement — mais votre vigilance à cet instant contribue à renforcer votre sécurité."
          }
        },
