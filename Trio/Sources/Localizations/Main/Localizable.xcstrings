    "Safety boundaries for insulin delivery and carb entries are set to help Trio keep you safe." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Safety boundaries for insulin delivery and carb entries are set to help Trio keep you safe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhedsgrænser for levering af insulin og carb poster er indstillet til at hjælpe Trio holde dig sikker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherheitsgrenzen für die Insulinabgabe und die Eingabe von Kohlenhydraten sind so eingestellt, dass Trio für Deine Sicherheit sorgt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Safety boundaries for insulin delivery and carb entries are set to help Trio keep you safe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définition de limites de sécurité pour l’administration d’insuline et l’ajout de glucides, afin d’aider Trio à garantir votre sécurité."
          }
        },
        "he" : {
          "stringUnit" : {
