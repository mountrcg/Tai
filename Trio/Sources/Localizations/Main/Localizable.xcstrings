    "Turning on the Sigmoid Formula setting alters how your Dynamic Ratio, and thus your New ISF, are calculated using a sigmoid curve." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turning on the Sigmoid Formula setting alters how your Dynamic Ratio, and thus your New ISF, are calculated using a sigmoid curve."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering af Sigmoid Formula indstillingen ændrer hvordan din Dynamic Ratio, og dermed din nye ISF, beregnes ved hjælp af en sigmoid kurve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Du die Einstellung Sigmoid-Formel aktivierst, wird Dein dynamisches Verhältnis und damit Dein neuer ISF anhand einer Sigmoid-Kurve berechnet."
