    "Trio does not collect any health related data, e.g. glucose readings, insulin rates or doses, meal data, setting values, or similar." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio does not collect any health related data, e.g. glucose readings, insulin rates or doses, meal data, setting values, or similar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio indsamler ingen sundhedsrelaterede data, f.eks. glukoseaflæsninger, insulin-rater eller -doser, måltidsdata, indstillinger eller lignende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio sammelt keine gesundheitsbezogenen Daten, z. B. Glukosemesswerte, Insulinraten oder -dosen, Mahlzeitendaten, Einstellungswerte oder ähnliches."
          }
        },
        "es" : {
          "stringUnit" : {
