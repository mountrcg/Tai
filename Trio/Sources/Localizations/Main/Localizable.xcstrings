    "The maximum deviation from the center value. Higher values create wider swings." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The maximum deviation from the center value. Higher values create wider swings."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den maksimale afvigelse fra centerværdien. Højere værdier skaber bredere gynger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die maximale Abweichung vom Mittelwert. Höhere Werte erzeugen größere Schwankungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La desviación máxima del valor central. Valores más altos crean oscilaciones más anchas."
          }
