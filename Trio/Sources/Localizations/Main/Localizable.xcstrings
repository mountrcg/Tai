    "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?" : {
      "comment" : "Profile Import AlertProfile Import Alert",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil erstatte nogle eller alle dine aktuelle pumpeindstillinger. Er du sikker på, at du vil importere profilindstillinger fra Nightscout?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wird einige oder alle Deiner aktuellen Pumpeneinstellungen ersetzen. Bist Du sicher, dass Du die Profileinstellungen von Nightscout importieren möchtest?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplazará algunos o todos los ajustes de la bomba actual. ¿Está seguro de que desea importar la configuración del perfil de Nightscout?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela remplacera certains ou l’ensemble de vos réglages actuels de pompe. Confirmez-vous l’importation des réglages de profil depuis Nightscout ?"
