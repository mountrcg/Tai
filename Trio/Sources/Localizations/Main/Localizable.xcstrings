        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đỉnh insulin này thông báo cho hệ thống biết thời điểm có thể đạt được hiệu quả hạ đường huyết mạnh nhất, giúp dự đoán xu hướng đường huyết chính xác hơn."
          }
        },
        "zh-Hant" : {
