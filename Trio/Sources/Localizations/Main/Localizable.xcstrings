    "Configuration changes will take effect on the next glucose reading." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Configuration changes will take effect on the next glucose reading."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurationsændringer vil træde i kraft ved næste glukoseaflæsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfigurationsänderungen werden bei der nächsten Glukoseanzeige wirksam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de configuración surtirán efecto en la próxima lectura de la glucosa."
