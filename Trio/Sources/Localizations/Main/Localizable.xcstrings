    "Trio calculates your current Insulin On Board (IOB) from:" : {

    },
    "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan automatisk tilpasse insulin levering baseret på input og glukose prognoser. Dine algoritmeindstillinger spiller en stor rolle i præcis og effektiv dosering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kann die Insulinabgabe automatisch auf der Grundlage von Eingaben und Glukoseprognosen anpassen. Deine Algorithmuseinstellungen spielen eine wichtige Rolle bei der genauen und effektiven Dosierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio peut adapter automatiquement l’administration d’insuline en fonction des données saisies et des prévisions de glucose. Vos réglages d’algorithme jouent un rôle essentiel dans la précision et l’efficacité du dosage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan automatisk tilpasse insulintilførsel basert på inndata og blodsukkerprognose. Algoritme-innstillingene dine spiller en viktig rolle for nøyaktig og effektiv dosering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan automatisch insuline levering aanpassen op basis van input en glucosevoorspellingen. Jouw algoritmeinstellingen spelen een belangrijke rol in nauwkeurige en effectieve dosis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio może automatycznie dostosowywać podawanie insuliny na podstawie danych wejściowych i prognoz glikemii. Twoje ustawienia algorytmu odgrywają główną rolę w dokładnym i skutecznym dawkowaniu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan automatiskt anpassa insulintillförseln baserat på registrerad information och glukosprognoser. Dina algoritminställningar spelar en viktig roll för korrekt och effektiv dosering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can automatically adapt insulin delivery based on inputs and glucose forecasts. Your algorithm settings play a major part in accurate and effective dosing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio có thể tự động điều chỉnh việc cung cấp insulin dựa trên dữ liệu đầu vào và dự báo đường huyết. Cài đặt thuật toán của bạn đóng vai trò quan trọng trong việc định lượng chính xác và hiệu quả."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 可以根據輸入和血糖預測自動調整胰島素輸送。你的演算法設定在準確和有效的劑量中扮演重要角色。"
          }
        }
      }
    },
    "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan give besked om forskellige begivenheder, når du bruger det. Du skal tillade Trio at sende dig notifikationer for at fungere korrekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kann Dich über verschiedene Ereignisse benachrichtigen, wenn Du es verwendest. Du musst Trio erlauben, Dir Benachrichtigungen zu senden, damit es richtig funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio peut vous avertir de différents événements pendant son utilisation. Vous devez autoriser l'app Trio à envoyer des notifications pour qu'elle fonctionne correctement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan varsle om forskjellige hendelser når du bruker appen. Du må tillate at Trio sender deg varsler for at dette skal fungere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan meldingen versturen van verschillende gebeurtenissen wanneer je deze gebruikt. Je moet Trio toestaan om meldingen te sturen om correct te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio może powiadamiać o różnych zdarzeniach. Musisz wyrazić zgodę na wysyłanie powiadomień żeby Trio działało prawidłowo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kan notifiera dig om olika händelser under användning. Du måste tillåta notiser från Trio för att det ska fungera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio can notify of different events when you use it. You must allow Trio to send you notifications to work properly."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio có thể thông báo về các sự kiện khác nhau khi bạn sử dụng. Bạn phải yêu cầu Trio gửi thông báo để hoạt động bình thường."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio 可以在使用時通知不同的事件。你必須允許 Trio 發送通知以正常運作。"
          }
        }
      }
    },
    "Trio collects the app's state on crash, device, iOS and general system info, and a stack trace." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio collects the app's state on crash, device, iOS and general system info, and a stack trace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio indsamler appens tilstand ved crash, enhed, iOS og generelle system info, og en stack trace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio sammelt den Status der App beim Absturz, Geräte-, iOS- und allgemeine Systeminformationen sowie einen Stack-Trace."
          }
        },
        "es" : {
          "stringUnit" : {
