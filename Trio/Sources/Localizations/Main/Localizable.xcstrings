        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio is a powerful app that helps you manage your diabetes. Let's get started by setting up a few important parameters that will help Trio work effectively for you."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio är en kraftfull app som hjälper dig att hantera din diabetes. Låt oss komma igång genom att sätta upp några viktiga parametrar som hjälper Trio att arbeta effektivt för dig."
