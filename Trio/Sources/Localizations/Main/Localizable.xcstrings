        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De veiligheidsgrenzen voor toediening van insuline zijn ingesteld om Trio te helpen jou veilig te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw granice dla podawania insuliny i wpisów węglowodanów, aby pomóc Trio zachować bezpieczeństwo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
