    "Add Preset or Override by tapping 'Add Override +' in the top right-hand corner of the screen." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add Preset or Override by tapping 'Add Override +' in the top right-hand corner of the screen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj Forudindstilling eller Overskrivning ved at trykke på 'Tilføj Overskrivning +' i øverste højre hjørne af skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Override hinzu, indem Du oben rechts auf dem Bildschirm auf 'Override hinzufügen +' tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir Preselección o Anulación pulsando 'Añadir Anulación +' en la esquina superior derecha de la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter un préréglage ou une dérogation (Override) en appuyant sur « Ajouter une dérogation +» dans le coin supérieur droit de l'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add Preset or Override by tapping 'Add Override +' in the top right-hand corner of the screen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi Preset o Override premendo 'Aggiungi Override +' nell'angolo in alto a destra dello schermo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 오른쪽 상단 모서리에 있는 '오버라이드 추가 +'를 탭하여 프리셋 또는 오버라이드를 추가합니다."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til forhåndsinnstilling eller overstyring ved å trykke 'Legg til overstyring +' øverst til høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorinstelling toevoegen of overschrijven door op 'Override +' te tikken in de rechterbovenhoek van het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj Nadpisanie poprzez dotknięcie 'Dodaj nadpisanie +' w prawym górnym rogu ekranu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione predefinição ou substitua tocando em 'Adicionar Substituição +' no canto superior direito da tela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till förval eller override genom att trycka på \"Lägg till override +\" i övre högra hörnet på skärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add Preset or Override by tapping 'Add Override +' in the top right-hand corner of the screen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати пресет або замінити, натиснувши «Перевизначити +» у правому верхньому куті екрану."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm cài đặt trước hoặc ghi đè bằng cách chạm vào 'Add Override +' ở góc trên bên phải của màn hình."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊螢幕右上角的「新增覆寫 +」來新增預設或覆寫。"
          }
        }
      }
    },
    "Add Preset or Temp Target by tapping 'Add Temp Target +' in the top right-hand corner of the screen." : {
