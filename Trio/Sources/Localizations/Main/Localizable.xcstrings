            "state" : "new",
            "value" : "Setting this to 100% means only the past 24 hours will be used."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved å angi dette til 100% vil kun de siste 24 timene bli brukt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% instellen betekent dat alleen de afgelopen 24 uur zal worden gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienie na 100% oznacza, że użyto tylko ostatnich 24 godzin."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
