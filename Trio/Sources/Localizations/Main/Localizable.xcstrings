    "Shows the COB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if carbs are added or removed after the fact." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the COB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if carbs are added or removed after the fact."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser COB værdien beregnet af algoritmen på et bestemt tidspunkt i fortiden. Disse værdier er snapshots og vil ikke ændres, hvis kulhydrater tilføjes eller fjernes efter faktum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den COB-Wert, der vom Algorithmus zu einem bestimmten Zeitpunkt in der Vergangenheit berechnet wird. Diese Werte sind Momentaufnahmen und werden sich nicht ändern, wenn Kohlenhydrate hinzugefügt oder entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el valor COB calculado por el algoritmo en un momento específico en el pasado. Estos valores son instantáneas y no cambiarán si los glúcidos se añaden o eliminan después del hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la valeur des glucides actifs (COB) calculée par l’algorithme à un instant précis dans le passé. Ces valeurs sont des instantanés et ne changeront pas si des glucides sont ajoutés ou supprimés par la suite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the COB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if carbs are added or removed after the fact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il valore COB calcolato dall'algoritmo in un momento specifico del passato. Questi valori sono istantanee e non cambieranno se i carboidrati vengono aggiunti o rimossi dopo il fatto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the COB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if carbs are added or removed after the fact."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser COB-verdien beregnet av algoritmen på et spesifikt tidspunkt i fortiden. Disse verdiene er øyeblikksbilder og vil ikke endres hvis karbohydrater legges til eller fjernes i ettertid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de COB waarde berekend door het algoritme op een bepaalde tijd in het verleden. Deze waarden zijn momentopnames en zullen niet worden gewijzigd als koolhydraten worden toegevoegd of na het gegeven worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje wartość COB obliczoną przez algorytm w określonym czasie w przeszłości. Wartości te są migawkami i nie ulegną zmianie, jeśli węglowodany zostaną dodane lub usunięte po fakcie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o valor de COB calculado pelo algoritmo em um momento específico no passado. Estes valores são instantâneos e não mudarão se os hidratos de carbono forem adicionados ou removidos a partir do fato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar COB-värdet beräknat av algoritmen vid en viss tidpunkt i det förflutna. Dessa värden är ögonblicksbilder och kommer inte att ändras om kolhydrater läggs till eller tas bort efter faktum."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the COB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if carbs are added or removed after the fact."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує значення COB за алгоритмом в певний час в минулому. Ці значення є знімками і не зміняться, якщо після факту додано або вилучено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị giá trị COB được thuật toán tính toán tại một thời điểm cụ thể trong quá khứ. Các giá trị này là ảnh chụp nhanh và sẽ không thay đổi nếu carbs được thêm vào hoặc loại bỏ sau đó."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示演算法在某特定時間計算的 COB 值。這些值是快照，即使在事後添加或刪除碳水化合物也不會改變。"
          }
        }
      }
    },
    "Shows the IOB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if insulin is added or removed after the fact." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the IOB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if insulin is added or removed after the fact."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser IOB værdien beregnet af algoritmen på et bestemt tidspunkt i fortiden. Disse værdier er snapshots og vil ikke ændre sig, hvis insulin tilsættes eller fjernes efter kendsgerningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den vom Algorithmus berechneten IOB-Wert zu einem bestimmten Zeitpunkt in der Vergangenheit an. Diese Werte sind Momentaufnahmen und werden sich nicht ändern, wenn Insulin nachträglich hinzugefügt oder entfernt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el valor IOB calculado por el algoritmo en un momento específico en el pasado. Estos valores son instantáneas y no cambiarán si se añade o elimina insulina después del hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la valeur de l’insuline active (IOB) calculée par l’algorithme à un instant précis dans le passé. Ces valeurs sont des instantanés et ne changeront pas si de l’insuline est ajoutée ou supprimée par la suite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the IOB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if insulin is added or removed after the fact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il valore IOB calcolato dall'algoritmo in un momento specifico del passato. Questi valori sono istantanee e non cambieranno se l’insulina viene aggiunta o rimossa dopo il fatto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the IOB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if insulin is added or removed after the fact."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser IOB-verdien beregnet av algoritmen på et spesifikt tidspunkt i fortiden. Disse verdiene er øyeblikksbilder og vil ikke endres hvis insulin legges til eller fjernes i ettertid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de IOB waarde berekend met het algoritme op een bepaald moment in het verleden. Deze waarden zijn momentopnamen en zullen niet worden gewijzigd als insuline na het gegeven wordt toegevoegd of verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje wartość IOB obliczoną przez algorytm w określonym czasie w przeszłości. Wartości te są migawkami i nie ulegną zmianie, jeśli insulina zostanie dodana lub usunięta po fakcie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o valor de IOB calculado pelo algoritmo em um momento específico no passado. Estes valores são snapshots e não alterarão se a insulina for adicionada ou removida após o fato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar IOB-värdet som beräknats av algoritmen vid en viss tidpunkt i det förflutna. Dessa värden är ögonblicksbilder och kommer inte att ändras om insulin läggs till eller tas bort efter fakta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the IOB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if insulin is added or removed after the fact."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує значення IOB за алгоритмом в певний час в минулому. Ці значення є знімками і не зміниться, якщо інсулін буде додано або видалено після факту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị giá trị IOB được thuật toán tính toán tại một thời điểm cụ thể trong quá khứ. Các giá trị này là ảnh chụp nhanh và sẽ không thay đổi nếu insulin được thêm vào hoặc loại bỏ sau đó."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示演算法在某特定時間計算的 IOB 值。這些值是快照，即使在事後添加或刪除胰島素也不會改變。"
          }
        }
      }
    },
