          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preset tymczasowego celu jest aktualnie uruchomiony. Usunięcie spowoduje zatrzymanie go."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta predefinição de destino Temp está em execução. Excluir irá pará-la."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta förinställda tillfälliga mål är aktiverat för närvarande. Radering kommer att stoppa det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This Temp Target preset is currently running. Deleting will stop it."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз працює тимчасовий шаблон. Видалення зупинить його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt sẵn Temp Target này hiện đang chạy. Xóa sẽ dừng cài đặt này."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此臨時目標預設目前正在運行。刪除將會停止它。"
          }
        }
      }
    },
    "This will add your current glucose on the top right of your Trio icon as a red notification badge. Changing setting takes effect on next Glucose reading." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will add your current glucose on the top right of your Trio icon as a red notification badge. Changing setting takes effect on next Glucose reading."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil tilføje dit nuværende glukose øverst til højre på dit Trio-ikon som et rødt meddelelsesmærke. Ændring indstilling træder i kraft på næste glukose læsning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird Deine aktuelle Glukose oben rechts auf dem Trio-Symbol als rotes Benachrichtigungssymbol hinzugefügt. Die Änderung der Einstellung wird bei der nächsten Glukosemessung wirksam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto añadirá tu glucosa actual en la parte superior derecha de tu icono de Trio como una insignia de notificación roja. El cambio de ajuste tiene efecto en la siguiente lectura de Glucosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela affichera votre mesure de glucose actuelle en haut à droite de l’icône de l'application Trio, sous forme de pastille de notification rouge. Tout changement de ce réglage prendra effet à la prochaine mesure de glucose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will add your current glucose on the top right of your Trio icon as a red notification badge. Changing setting takes effect on next Glucose reading."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo aggiungerà il tuo glucosio attuale in alto a destra dell'icona del tuo Trio come distintivo di notifica rosso. La modifica dell'impostazione ha effetto sulla prossima lettura del glucosio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will add your current glucose on the top right of your Trio icon as a red notification badge. Changing setting takes effect on next Glucose reading."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil legge til din nåværende blodsukkerverdi øverst til høyre på Trio-ikonet ditt som et rødt varslingsmerke. Endring av innstilling trer i kraft ved neste måling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit voegt je huidige glucose rechtsboven aan je Trio-pictogram toe als een rode meldings-badge. Verandering van instellingen heeft effect op de volgende Glucose lezing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to dodanie aktualnego poziomu glikemii w prawym górnym rogu ikony Trio jako czerwonego znacznika powiadomienia. Zmiana ustawienia zostanie wprowadzona przy następnym odczycie poziomu glukozy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá adicionar sua glicose atual no canto superior direito do seu ícone Trio como um emblema de notificação vermelha. Configuração de mudança tem efeito na próxima leitura de Glicose."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kommer att lägga till ditt nuvarande glukosvärde längst upp till höger på din Trio-ikon som ett rött meddelandemärke. Ändrad inställning träder i kraft vid nästa Glukosavläsning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will add your current glucose on the top right of your Trio icon as a red notification badge. Changing setting takes effect on next Glucose reading."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це додасть ваш поточний глюкоза у правому верхньому куті вашого Trio в якості червоного значка сповіщення. Зміна налаштувань впливає на наступне читання глюкози."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ thêm lượng đường huyết hiện tại của bạn vào góc trên bên phải biểu tượng Trio dưới dạng huy hiệu thông báo màu đỏ. Thay đổi cài đặt có hiệu lực vào lần đọc đường huyết tiếp theo."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將在您的 Trio 圖示的右上角新增您當前的血糖作為紅色通知標記。更改的設定將在下一次血糖讀取時生效。"
          }
        }
      }
    },
