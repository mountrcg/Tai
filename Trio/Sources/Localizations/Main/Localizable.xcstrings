    "Nightscout use is entirely optional. You can also setup Nightscout at a later time." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nightscout use is entirely optional. You can also setup Nightscout at a later time."
          }
