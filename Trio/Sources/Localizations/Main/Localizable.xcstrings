    "Trio lets you create automations using iOS Shortcuts. Go to the Shortcuts app to create new automations." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio lets you create automations using iOS Shortcuts. Go to the Shortcuts app to create new automations."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio lader dig oprette automatiseringer ved hjælp af iOS-genveje. Gå til Genvejs-appen for at oprette nye automatiseringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Trio kannst Du Automatisierungen mit iOS Kurzbefehlen erstellen. Gehe zur App \"Kurzbefehle\", um neue Automatisierungen zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio te permite crear automatizaciones usando los accesos directos de iOS. Ve a la aplicación de accesos directos para crear nuevas automatizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio vous permet de créer des automatisations avec Raccourcis iOS. Ouvrez l’app « Raccourcis » pour créer de nouvelles automatisations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
