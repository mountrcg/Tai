        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trios Simple Lock Screen Widget viser aktuelle glukoseaflæsning, trendpil, delta og tidsstempel for den aktuelle aflæsning."
          }
        },
        "de" : {
          "stringUnit" : {
