    "Triggers a confirmation dialog if you attempt to bolus when glucose is < %@ %@." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers a confirmation dialog if you attempt to bolus when glucose is < %1$@ %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløser en bekræftelsesdialog, hvis du forsøger at bolus når glucose er < %1$@ %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst einen Bestätigungsdialog aus, falls Du versuchst, einen Bolus zu verabreichen, wenn die Glukose < %1$@ %2$@ ist."
          }
        },
        "en" : {
