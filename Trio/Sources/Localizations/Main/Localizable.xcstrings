    "Note: These values are not used to calculate insulin dosing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: These values are not used to calculate insulin dosing."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Disse værdier anvendes ikke til at beregne insulindosis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Diese Werte werden nicht zur Berechnung der Insulindosierung verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Estos valores no se utilizan para calcular la dosis de insulina."
