    "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains." : {
      "comment" : "Format string for the action string on pod status page when pod expired. (1: service time remaining)",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift Pod nu. Levering af insulin vil stoppe i %1$@ eller når der ikke er mere insulin tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle jetzt den Pod! Die Insulinabgabe wird in %1$@ unterbrochen, spätestens wenn kein Insulin mehr vorhanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el Pod ahora. La entrega de insulina se detendrá en %1$@ o cuando no quede más insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacez le Pod dès maintenant. L'administration d'insuline s'arrêtera dans %1$@ ou quand il n'y aura plus d'insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare Pod adesso. L' erogazione d'insulina si interromperà tra %1$@ o quando non ci sarà più insulina nel serbatoio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt pod nå. Insulintilførselen stopper om %1$@, eller når det er tomt for insulin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervang Pod nu. Insulinetoediening stopt over %1$@ of wanneer er geen insuline meer over is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymień PODa. Podawanie insuliny zostanie zatrzymane za %1$@ lub gdy zabraknie insuliny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar Pod agora. A entrega de insulina irá parar em %1$@ ou quando não houver mais insulina permanecer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt podd nu. Insulintillförseln kommer att stoppas om %1$@ eller när insulinet är slut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть Pod зараз. Введення інсуліну припиниться через %1$@ або коли інсулін закінчиться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay pod ngay. Insulin sẽ ngưng tiêm trong %1$@ hoặc khi không còn insulin."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即變更 Pod。胰島素輸送將在 %1$@ 停止或當不再有胰島素時停止。"
          }
        }
      }
