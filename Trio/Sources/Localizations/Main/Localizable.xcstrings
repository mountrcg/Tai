    "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at deaktivere udjævning, gå til Indstillinger > Enheder > Kontinuerlig glukose skærm > Glat glukose værdi og slå indstillingen fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Glättung zu deaktivieren, gehe zu Einstellungen > Geräte > Kontinuierliches Glukosemessgerät > Glukosewert glätten und schalte die Einstellung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desactivar el alisado, vaya a Ajustes > Dispositivos > Glucosa Continua Monitor> Suavizado Valor de Glucosa y desactive la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour désactiver le lissage, allez dans Réglages > Appareils > Capteur de glucose en continu > Lisser la mesure de glucose, puis désactivez ce réglage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per disabilitare la levigatura, vai in Impostazioni > Dispositivi > Monitor Glicemia Continuo > Liscia il Valore Glicemia e disattiva l'impostazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å deaktivere utjevning, gå til Innstillinger > Enheter > Sensor > Utjevning av blodsukker og slå av innstillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om vloeiend uit te schakelen, ga naar Instellingen > Apparaten > Continue Glucose Monitor > Smooth Glucose Waarde en schakel de instelling uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wyłączyć wygładzanie, przejdź do Ustawienia > Urządzenia > Ciągły pomiar glikemii > Wygładź wartość glikemii i wyłącz ustawienie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desativar a suavidade, vá para Configurações > Dispositivos > Monitoramento de Glucose Contínuo > Valor de Glucose Suave e desative a configuração."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att inaktivera utjämning, gå till Inställningar > Enheter > CGM (Kontinuerlig glukosmätare) > Utjämna glukosvärden från sensor och inaktivera inställningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб відключити плавно, перейдіть до Налаштувань > пристроїв > Безперервний монітор Glucose > Smooth Glucose Значення і вимкніть налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
