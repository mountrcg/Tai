    "1. Open the Settings app on your iOS device." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1. Open the Settings app on your iOS device."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Åbn appen Indstillinger på din iOS enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öffne die Einstellungs-App auf Deinem iOS-Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Abre la aplicación Ajustes en tu dispositivo iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
