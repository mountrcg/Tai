            "value" : "Denne funksjonen sikrer mer nøyaktige insulinjusteringer når registrering av karbohydrater mangler eller er unøyaktig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze functie zorgt voor nauwkeurigere insuline aanpassingen wanneer de invoer van koolhydraten ontbreekt of onjuist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta funkcja zapewnia dokładniejsze dostosowanie insuliny w przypadku braku lub niepoprawnych wpisów węglowodanów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este recurso garante ajustes de insulina mais precisos quando as entradas carb estão ausentes ou incorretas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
