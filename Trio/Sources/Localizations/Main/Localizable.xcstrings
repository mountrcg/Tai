          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo sostituirà alcune o tutte le impostazioni attuali del microinfusore. Sei sicuro di voler importare le impostazioni del profilo da Nightscout?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil erstatte alle eller deler av dine nåværende pumpeinnstillinger. Er du sikker på at du vil importere profilinnstillinger fra Nightscout?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zal enkele of al je huidige pomp instellingen vervangen. Weet je zeker dat je de profielinstellingen uit Nightscout wilt importeren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to zastąpienie niektórych lub wszystkich bieżących ustawień pompy. Czy na pewno chcesz zaimportować ustawienia profilu z Nightscout?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá substituir algumas ou todas as configurações da sua bomba atual. Tem certeza de que deseja importar as configurações de perfil do Nightscout?"
          }
        },
        "sv" : {
          "stringUnit" : {
