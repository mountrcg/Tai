    "Dynamically adjust insulin sensitivity using Dynamic Ratio rather than Autosens Ratio." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dynamically adjust insulin sensitivity using Dynamic Ratio rather than Autosens Ratio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justér insulinfølsomheden dynamisk ved hjælp af Dynamisk Ratio frem for Autosens Ratio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamische Anpassung der Insulinempfindlichkeit mit Dynamischem Verhältnis statt Autosens Verhältnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar dinámicamente la sensibilidad de la insulina usando la relación dinámica en lugar de la relación de autosenses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster dynamiquement la sensibilité à l'insuline à l'aide du ratio ISF dynamique au lieu du ratio Autosens."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dynamically adjust insulin sensitivity using Dynamic Ratio rather than Autosens Ratio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola dinamicamente la sensibilità all'insulina utilizzando il Rapporto Dinamico anziché il Rapporto di Autosens."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dynamically adjust insulin sensitivity using Dynamic Ratio rather than Autosens Ratio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justerer insulinfølsomheten ved hjelp av dynamisk ratio i stedet for Autosens ratio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insuline gevoeligheid dynamisch aanpassen in plaats van Autosens Ratio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamicznie dostosowuje wrażliwość na insulinę stosując współczynnik dynamiczny zamiast współczynnika Autosens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
