          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanligvis er blodsukkeret farget rødt når det er over eller under dine terskler for varsling av høyt/lavt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normaal gesproken wordt glucose alleen rood gekleurd als je de notificatiegrens hebt overschreden voor hoog/laag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
