        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Widget de Pantalla de Bloqueo Detallado ofrece a los usuarios un gráfico de glucosa así como la capacidad de personalizar la información proporcionada en el Widget detallado utilizando las siguientes opciones:"
