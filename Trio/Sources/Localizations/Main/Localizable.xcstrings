          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il tuo obiettivo di glucosio è %1$@ %2$@, Trio userà una soglia di sicurezza di %3$@ %4$@, a meno che non si imposta la soglia minima di sicurezza a qualcosa > %5$@ %6$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
