    },
    "This setting changes how much effect the fat and protein entry has on FPUs." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting changes how much effect the fat and protein entry has on FPUs."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling ændrer hvor meget effekt fedt og protein post har på FPU'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung ändert, wie stark sich die Eingabe von Fett und Eiweiß auf die FPUs auswirkt."
          }
        },
        "es" : {
