    "Trio does not track any usage metrics or any other personal data about users other than the used iPhone model and iOS version." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trio does not track any usage metrics or any other personal data about users other than the used iPhone model and iOS version."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio sporer ikke nogen brugsmålinger eller andre personlige data om andre brugere end den brugte iPhone-model og iOS-version."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio verfolgt keine Nutzungsmetriken oder andere persönliche Daten über die Nutzer außer dem verwendeten iPhone-Modell und der iOS-Version."
