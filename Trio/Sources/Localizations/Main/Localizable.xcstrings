    "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running Trio i lukket loop mode kræver en aktiv CGM sensor session og en tilsluttet pumpe. Dette muliggør automatisk insulinlevering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Trio im Closed Loop Modus zu betreiben, werden eine aktive CGM-Sensor-Session und eine angeschlossene Pumpe benötigt. Dies ermöglicht eine automatisierte Insulinlieferung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El funcionamiento de Trio en modo de ciclo cerrado requiere una sesión activa del sensor CGM y una bomba conectada. Esto permite la entrega automática de insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser Trio en mode boucle fermée nécessite une session active du capteur de glucose en continu (CGM) et une pompe connectée. Cela permet l’administration automatisée d’insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esecuzione del Trio in modalità loop chiuso richiede una sessione attiva di sensori CGM e una pompa collegata. Ciò consente la somministrazione automatica di insulina."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å kjøre Trio i lukket loop-modus kreves det en aktiv CGM-sensor og en tilkoblet pumpe. Dette muliggjør automatisert insulintilførsel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio uitvoeren in Closed Loop-modus vereist een actieve CGM-sensorsessie en verbinding met een pomp. Dit activeert automatische insulinetoediening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamianie trio w trybie zamkniętej pętli wymaga aktywnej sesji czujnika CGM i podłączonej pompy. Umożliwia to automatyczne dostarczanie insuliny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executar Trio em modo de loop fechado requer uma sessão de sensor CGM ativa e uma bomba conectada. Isso permite a entrega de insulina automatizada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att köra Trio i sluten loop-läge kräver en aktiv CGM-sensor och en ansluten pump. Detta möjliggör automatisk tillförsel av insulin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запуск Trio в закритому режимі циклу вимагає активної сесії CGM датчика та під'єднаного насосу. Це вмикає автоматизовану доставку інсуліну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy Trio ở chế độ vòng lặp kín (closed loop) yêu cầu có phiên cảm biến CGM đang hoạt động và bơm insulin được kết nối. Điều này cho phép hệ thống tự động bơm insulin."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以封閉迴路模式運行 Trio 需要一個有效的 CGM 感應器會話及已連線的幫浦。這啟用自動胰島素傳送。"
          }
        }
      }
    },
