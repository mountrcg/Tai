    "Warning: Increasing this value above 60 minutes may impact Trio's ability to effectively zero temp and prevent lows." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: Increasing this value above 60 minutes may impact Trio's ability to effectively zero temp and prevent lows."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: Øgning af denne værdi over 60 minutter kan påvirke Trios evne til effektivt at nulstille temp og forhindre lav."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: Die Erhöhung dieses Wertes über 60 Minuten kann die Fähigkeit von Trio beeinflussen, effektiv Temporäre-Basalraten von Null zu starten und niedrige Werte zu verhindern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertencia: Incrementar este valor por encima de 60 minutos puede afectar a la capacidad de Trío de cero, y prevenir bajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Attention : Augmenter cette valeur au-delà de 60 minutes peut nuire à la capacité de Trio de ramener à zéro le débit basal temporaire et à éviter les hypoglycémies."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: Increasing this value above 60 minutes may impact Trio's ability to effectively zero temp and prevent lows."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione: aumentare questo valore al di sopra dei 60 minuti può influire sulla capacità di Trio di azzerare efficacemente la temperatura e prevenire i bassi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: Increasing this value above 60 minutes may impact Trio's ability to effectively zero temp and prevent lows."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: En økning av denne verdien over 60 minutter kan påvirke Trios evne til effektivt å stoppe basaltilførsel for å unngå føling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwing: Het verhogen van deze waarde boven de 60 minuten kan invloed hebben op het vermogen van Trio om feitelijk een tijdelijk nultarief te gebruiken en laagtes te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie: Zwiększenie tej wartości powyżej 60 minut może mieć wpływ na zdolność urządzenia Trio do efektywnego zerowania bazy i zapobiegania spadkom glikemii."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: aumentar este valor acima de 60 minutos pode impactar a habilidade de Trio de efetivamente zero temp e evitar baixos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning: Att öka detta värde över 60 minuter kan påverka Trios förmåga att effektivt stänga av basalen i tid och förhindra låga glukosvärden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: Increasing this value above 60 minutes may impact Trio's ability to effectively zero temp and prevent lows."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередження: Збільшення цього значення більше 60 хвилин може вплинути на здатність трикутника та запобігти зниженню об'єктів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo: Việc tăng giá trị này lên trên 60 phút có thể ảnh hưởng đến khả năng Trio đưa Temp về mức 0 và ngăn ngừa tình trạng hạ đường huyết."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：將此數值提高至60分鐘以上，可能會影響Trio有效歸零的能力並防止低血糖。"
          }
        }
      }
    },
