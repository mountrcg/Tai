    "Do not enable this feature until you have optimized your CR (carb ratio) setting." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do not enable this feature until you have optimized your CR (carb ratio) setting."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver ikke denne funktion, før du har optimeret din CR (carb ratio) indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere diese Funktion erst, wenn Du Deine CR-Einstellung (Kohlenhydrat:Insulin-Verhältnis) optimiert hast."
          }
        },
