        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio er en kraftig app som hjelper deg å administrere din diabetes. La oss komme i gang ved å sette opp noen viktige parametere som vil hjelpe Trio å fungere effektivt for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio is een krachtige app die u helpt uw diabetes te beheren. Laten we beginnen met het instellen van een paar belangrijke parameters die Trio helpen om effectief voor jou te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio to potężna aplikacja, która pomaga Ci zarządzać cukrzycą. Zacznijmy od skonfigurowania kilku ważnych parametrów, które pomogą Trio działać skutecznie dla Ciebie."
          }
