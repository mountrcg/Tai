    },
    "Your carb ratio tells how many grams of carbohydrates one unit of insulin will cover. This is essential for accurate meal bolus calculations." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your carb ratio tells how many grams of carbohydrates one unit of insulin will cover. This is essential for accurate meal bolus calculations."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deres kulhydratforhold angiver, hvor mange gram kulhydrater en enhed insulin vil dække. Dette er vigtigt for nøjagtige bolusberegninger ved måltider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kohlenhydratverhältnis gibt an, wie viele Gramm Kohlenhydrate eine Einheit Insulin abdeckt. Dies ist wichtig für die genaue Berechnung des Mahlzeitenbolus."
          }
        },
        "es" : {
