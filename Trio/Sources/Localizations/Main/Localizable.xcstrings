    "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du kan begynde med at konfigurere dine terapiindstillinger Trio skal vide, hvilke enheder du bruger til dine glukose og insulinmålinger (baseret på din pumpemodel)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor Du mit der Konfiguration Deiner Therapieeinstellungen anfangen kannst, muss Trio wissen, welche Einheiten Du für Deine Glukose- und Insulineingaben verwendest (abhängig von Deinem Pumpenmodell)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de pouvoir commencer la configuration de vos réglages de thérapie, Trio doit connaître les unités utilisées pour vos mesures de glucose et d’insuline, (selon le modèle de votre pompe)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du kan begynne med å konfigurere behandlingsinnstillingene, må Trio vite hvilke enheter du bruker til blodsukker- og insulin (basert på pumpemodellen din)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voordat u kunt beginnen met het configureren van uw therapie instellingen, moet Trio weten welke eenheden je gebruikt voor jouw glucose en insulinemetingen (gebaseerd op jouw pompmodel)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim zaczniesz konfigurować ustawienia terapii, Trio musi wiedzieć, jakich jednostek używasz do pomiaru stężenia glukozy i insuliny (na podstawie modelu pompy)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan du kan börja konfigurera dina behandlingsinställningar, behöver Trio veta vilka enheter du använder för dina glukos- och insulinmätningar (baserat på din pumpmodell)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before you can begin with configuring your therapy settings, Trio needs to know which units you use for your glucose and insulin measurements (based on your pump model)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi bạn có thể bắt đầu cấu hình cài đặt liệu pháp điều trị, Trio cần biết bạn sử dụng đơn vị nào để đo lượng đường huyết và insulin (dựa trên kiểu máy bơm của bạn)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您可以開始配置治療設定之前，Trio 需要知道您使用哪個單位來測量血糖和胰島素（基於您的幫浦型號）。"
          }
        }
      }
    },
