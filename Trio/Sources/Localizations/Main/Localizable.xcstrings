        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoạt động trực tiếp hiển thị mức đường huyết theo thời gian thực trên màn hình khóa và trên Dynamic Island (nếu có)"
          }
