        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio collecte l’état de l’application au moment du crash, les informations sur l’appareil, iOS et le système en général, ainsi qu’une trace d’exécution (stack trace)."
          }
        },
        "he" : {
