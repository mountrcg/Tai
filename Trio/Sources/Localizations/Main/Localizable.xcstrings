        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Trio verbinden, um Deine Diabetesdaten nahtlos in Tidepool hochzuladen und zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
