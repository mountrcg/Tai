        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докладний віджет екрану блокування надає користувачам таблицю глюкози, а також можливість налаштовувати інформацію, що надається у докладному віджеті, використовуючи такі параметри:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiện ích Màn hình khóa chi tiết cung cấp cho người dùng biểu đồ đường huyết cũng như khả năng tùy chỉnh thông tin được cung cấp trong Tiện ích chi tiết bằng các tùy chọn sau:"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細鎖定螢幕小工具提供血糖圖表，以及使用以下選項自訂在詳細小工具中提供的資訊的能力："
          }
        }
      }
    },
    "The Duration of Insulin Action (DIA) defines how long your insulin continues to lower glucose readings after a dose." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Duration of Insulin Action (DIA) defines how long your insulin continues to lower glucose readings after a dose."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varigheden af insulinet (DIA) definerer, hvor længe Deres insulin fortsætter med at nedsætte blodsukkerværdierne efter en dosis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dauer der Insulinwirkung (DIA) legt fest, wie lange Dein Insulin nach einer Dosis die Glukosewerte weiter senken wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Duración de la Acción de Insulina (DIA) define cuánto tiempo su insulina continúa bajando las lecturas de glucosa después de una dosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durée d’action de l’insuline (DIA) correspond au temps pendant lequel l’insuline continue de faire baisser les mesures de glucose après son administration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Duration of Insulin Action (DIA) defines how long your insulin continues to lower glucose readings after a dose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durata dell’azione di insulina (DIA) definisce per quanto tempo l’insulina continua a ridurre i valori di glucosio dopo una dose."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Duration of Insulin Action (DIA) defines how long your insulin continues to lower glucose readings after a dose."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varighet av insulineffekt (DIA) definerer hvor lenge insulinet fortsetter å senke blodsukkeret etter dosering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Duur van Insulin Action (DIA) bepaalt hoe lang je insuline blijft doorlopen met het verlagen van je glucosewaardes na een dosis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas działania insuliny (DIA) określa, jak długo insulina będzie zmniejszać stężenie glukozy po podaniu dawki."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Duração da Ação de Insulina (DIA) define quanto tempo sua insulina continua a reduzir as leituras de glicose após uma dose."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulinets verkningstid (DIA) definierar hur länge ditt insulin fortsätter att sänka glukosvärden efter en dos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Duration of Insulin Action (DIA) defines how long your insulin continues to lower glucose readings after a dose."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тривалість дії інсуліну (DIA) визначає, як довго ваш інсулін продовжує знижувати читання глюкози після дози."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian tác dụng của insulin (DIA) xác định thời gian insulin tiếp tục làm giảm lượng đường trong máu sau khi tiêm một liều."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胰島素作用持續時間 (DIA) 定義胰島素在劑量後持續降低血糖讀取值的時間。"
          }
        }
      }
    },
    "The duration of insulin action (DIA) is now locked to Trio’s new default of 10 hours." : {
