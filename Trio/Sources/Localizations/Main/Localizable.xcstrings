          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach links wischen, um eine Override-Vorlage zu bearbeiten oder zu löschen. Halten, ziehen und Ablegen, um eine Vorlage neu zu ordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para editar o eliminar un preset de sobrescritura. Mantenga presionado, arrastre y suelte para reordenar un preset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour modifier ou supprimer une Dérogation favorite. Touchez, maintenez, puis faites glisser pour réorganiser une Dérogation favorite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to edit or delete an override preset. Hold, drag and drop to reorder a preset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra per modificare o eliminare una preimpostazione di override. Tieni, trascina e rilascia per riordinare una preimpostazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to edit or delete an override preset. Hold, drag and drop to reorder a preset."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til venstre for å redigere eller slette en forhåndsinnstilling. Hold, dra og slipp for å endre rekkefølgen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om een override preset te bewerken of te verwijderen. Houd ingedrukt en sleep om een nieuwe volgorde te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcem w lewo, aby edytować lub usunąć nadpisanie. Przytrzymaj i przeciągnij i upuść, aby zmienić kolejność ustawień."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para editar ou excluir uma predefinição de substituição. Mantenha pressionado, arraste e solte para reordenar uma predefinição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt vänster för att redigera eller ta bort ett override-förval. Håll, dra och släpp för att ändra ordning i listan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to edit or delete an override preset. Hold, drag and drop to reorder a preset."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свайпніть ліворуч, щоб змінити порядок або видалити пресет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt sang trái để chỉnh sửa hoặc xóa cài đặt trước ghi đè. Giữ, kéo và thả để sắp xếp lại cài đặt trước."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左滑動以編輯或刪除覆寫預設。長按、拖曳並放下以重新排序預設。"
          }
        }
      }
    },
