            "value" : "Affiche une dose d’insuline, qui peut être une petite dose automatique (Super Micro Bolus (SMB)), une dose saisie manuellement ou une dose administrée en externe (ex. : injection au stylo)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
