            "value" : "Increase the safety threshold used to suspend insulin delivery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forøg den sikkerhedstærskel, der anvendes til at suspendere insulinleveringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöht die Sicherheitsschwelle, welche zur Unterbrechung der Insulinabgabe genutzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
