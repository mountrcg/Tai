        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會決定從單一脂肪和/或蛋白質注射計算器條目之間，個別脂肪-蛋白質單元碳水化合物相當物(FPU)條目的分鐘數。"
          }
        }
      }
    },
