    },
    "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er en faktor, der anvendes i kombination med fedt- og proteindelay-proteindelay, spread Interval, og fedt- og proteinfaktor til at skabe FPU-poster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist ein Faktor, der in Kombination mit der Fett- und Protein-Verzögerung, dem Verteilungs-Interval und dem Fett- und Protein-Faktor verwendet wird, um die FPU Einträge zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un factor utilizado en combinación con el retraso en grasas y proteínas, intervalo de propagación y factor de grasa y proteínas para crear las entradas de FPU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paramètre est l’un des facteurs utilisés, en combinaison avec le « Délai pour Lipides et Protéines », « l’intervalle de répartition FPU » et le « Facteur des lipides et protéines », pour générer les ajouts de FPU."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un fattore usato in combinazione con il Fat and Protein Delay, Intervallo di diffusione e Fat e Protein Factor per creare le voci FPU."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er en faktor som brukes i kombinasjon med fett- og proteinforsinkelse, spredningsintervallet og fett- og proteinfaktor for å skape FPU-registreringene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is een factor die gebruikt wordt in combinatie met de Fat en Protein Delay, Spread Interval, Fat en Protein Factor om de FPU items te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest to jeden z czynników używanych w połączeniu z parametrami opóźnienia tłuszczu i białka, czasu rozkładu oraz współczynnika tłuszczu i białka w celu tworzenia wpisów FPU."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um factor utilizado em combinação com o Gordura e proteínas Delay, o Intervalo de Spread e o Fator de Gorduras e Proteínas para criar as entradas do FPU."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är en faktor som används i kombination med fett och protein fördröjning, spridningsintervall, och fett- och protein-faktor för att skapa FPU poster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це один фактор, який використовується у поєднанні з затримкою жиру та Білу, Інтервал поширення і жир і фактор білків для створення записів FPU."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là một yếu tố được sử dụng kết hợp với Độ trễ chất béo và chất đạm, Khoảng thời gian Phân bố và Yếu tố chất béo và chất đạm để tạo ra các mục nhập FPU."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它是與脂肪和蛋白質延遲、分散間隔和脂肪及蛋白質因子一起使用的一個因素，以創建FPU條目。"
          }
        }
      }
    },
    "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser på de sidste 8-24 timers data, bortset fra måltidsrelaterede ændringer, og justerer insulinindstillinger som basalsatser og mål efter behov for at matche din følsomhed eller resistens over for insulin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es schaut sich die letzten 8-24 Stunden an Daten an, ohne Änderungen im Zusammenhang mit Mahlzeiten und passt Insulineinstellungen wie Basalwerte und Ziele an, um Deine Empfindlichkeit oder Widerstandsfähigkeit gegen Insulin anzupassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echa un vistazo a las últimas 8-24 horas de datos, excluyendo los cambios relacionados con la comida y ajusta los ajustes de insulina como las tasas basales y los objetivos cuando sea necesario para ajustarse a su sensibilidad o resistencia a la insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il analyse les 8 à 24 dernières heures de données, en excluant les variations liées aux repas, et ajuste les paramètres d’insuline — comme le profil basal et les Cibles — si nécessaire, afin de refléter votre sensibilité ou résistance à l’insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende in esame le ultime 8-24 ore di dati, esclusi i cambiamenti legati ai pasti, e regola le impostazioni dell’insulina come velocità basali e bersagli quando necessario per abbinare la sua sensibilità o resistenza all’insulina."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tar for seg de siste 8-24 timene med data, unntatt måltidsrelaterte endringer, og justerer innstillinger som basaldose og blodsukkermål for å tilpasse til din insulinfølsomhet eller insulinresistens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kijkt naar de laatste 8-24 uur aan gegevens, met uitzondering van de maaltijdgerelateerde wijzigingen. en past insuline instellingen aan zoals basaalstanden en doelen wanneer nodig om jouw gevoeligheid of weerstand te laten overeenkomen met jouw insuline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizuje dane z ostatnich 8–24 godzin, z wyłączeniem zmian związanych z posiłkami, i w razie potrzeby dostosowuje ustawienia insuliny, takie jak dawki podstawowe i docelowe, aby uwzględnić wrażliwość lub oporność na insulinę."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa as últimas 8-24 horas dos dados, excluindo alterações relacionadas com refeições e ajusta as configurações de insulina, como taxas basais e alvos, quando necessário para atender à sua sensibilidade ou resistência à insulina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man tittar på de senaste 8-24 timmarna av data, exklusive måltidsrelaterade förändringar, och justerar insulininställningar som basal och glukosmål när det behövs för att matcha din känslighet eller resistens mot insulin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона дивиться на останні 8-24 години даних, за винятком змін, пов’язаних з їжею, і налаштовує налаштування інсуліну, такі як базові показники і цілі, якщо потрібно встановити відповідність вашої чутливості або опору інсуліну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng này sẽ xem xét dữ liệu trong 8-24 giờ qua, không bao gồm những thay đổi liên quan đến bữa ăn, và điều chỉnh các cài đặt insulin như tỷ lệ cơ bản và mục tiêu khi cần để phù hợp với độ nhạy hoặc khả năng kháng insulin của bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它會查看過去8-24小時的資料，排除與用餐相關的變化，並在需要時調整胰島素設定，如基礎率和目標，以符合你的胰島素敏感性或抵抗力。"
          }
        }
      }
    },
    "It serves as a safety limit, ensuring no temporary basal rates exceed safe levels." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It serves as a safety limit, ensuring no temporary basal rates exceed safe levels."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fungerer som en sikkerhedsgrænse, der sikrer, at ingen midlertidige basale hastigheder overskrider sikre niveauer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie dient als Sicherheitsgrenze, um sicherzustellen, dass keine Temporären Basalraten sichere Werte überschreiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve como límite de seguridad, asegurando que las tasas basales temporales no superen los niveles seguros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sert de limite de sécurité, garantissant que les débits basaux temporaires ne dépassent pas des niveaux sûrs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It serves as a safety limit, ensuring no temporary basal rates exceed safe levels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve come limite di sicurezza, garantendo che le percentuali basali temporanee superino i livelli di sicurezza."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It serves as a safety limit, ensuring no temporary basal rates exceed safe levels."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den fungerer som en sikkerhetsgrense, ved å sikre at ingen midlertidige basalrater overstiger sikre nivåer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het dient als veiligheidslimiet, waarbij geen tijdelijke basaalstanden worden gegarandeerd die de veilige niveaus overschrijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanowi granicę bezpieczeństwa zapewniającą, że żadne tymczasowe dawki podstawowe nie przekroczą bezpiecznych poziomów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve como um limite de segurança, garantindo que nenhuma basal temporária exceda os níveis de segurança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fungerar som en säkerhetsgräns, vilket garanterar att inga tillfälliga basalnivåer överstiger säkra nivåer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It serves as a safety limit, ensuring no temporary basal rates exceed safe levels."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він служить в якості обмеження безпеки, забезпечення тимчасового базового рівня не перевищує безпечний рівень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó đóng vai trò là giới hạn an toàn, đảm bảo không có mức tỷ lệ liều cơ bản tạm thời nào vượt quá mức an toàn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它作為一個安全限制，確保沒有臨時基礎率超過安全水平。"
          }
        }
      }
    },
    "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bruger SMB (Super Micro Bolus) algoritmen til at levere insulin i små mængder til at korrigere glukose pigge. UAM virker også reversibelt, idet det reducerer eller stopper SMB'er, hvis glukoseniveauet falder uventet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es verwendet den SMB-Algorithmus (Super Micro Bolus), um Insulin in kleinen Mengen zur Korrektur von Glukosespitzen zu liefern. UAM funktioniert auch umgekehrt, reduziert oder stoppt SMBs, wenn der Glukosegehalt unerwartet sinkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza el algoritmo SMB (Super Micro Bolus) para entregar insulina en pequeñas cantidades para corregir los picos de glucosa. UAM también funciona en inversa, reduciendo o parando SMB si los niveles de glucosa caen inesperadamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il utilise l’algorithme SMB (Super Micro Bolus) pour administrer de petites quantités d’insuline afin de corriger les hausses de glucose. UAM fonctionne également en sens inverse, en réduisant ou en interrompant les SMB si le niveau de glucose baisse de manière inattendue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza l'algoritmo SMB (Super Micro Bolus) per erogare insulina in piccole quantità per correggere i picchi di glucosio. UAM agisce anche per invertire, ridurre o arrestare le piccole e medie imprese se i livelli di glucosio diminuiscono inaspettatamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den bruker SMB (Super Mikro Bolus) for å levere insulin i små mengder for å korrigere blodsukkerstigning. UAM virker også motsatt, ved å senke eller stoppe SMB hvis blodsukkernivået faller uventet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gebruikt het SMB (Super Micro Bolus) algoritme om in kleine hoeveelheden insuline toe te dienen voor het corrigeren van glucosepieken. UAM werkt ook omgekeerd, verminderen of stoppen met SMB's als de glucosewaardes onverwacht dalen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystuje algorytm SMB (Super Micro Bolus) do dostarczania insuliny w małych ilościach w celu skorygowania skoków glikemii. UAM działa również zmniejszając lub zatrzymując SMB, jeśli poziom glukozy niespodziewanie spadnie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele usa o algoritmo SMB (Super Micro Bolus) para entregar insulina em pequenas quantidades para corrigir espinhos de glicose. O UAM também funciona em sentido inverso, redução ou interrupção de SMBs caso os níveis de glicose caíssem inesperadamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den använder SMB (Super Micro Bolus) algoritmen för att leverera insulin i små mängder för att korrigera glukosstigningar. UAM fungerar också omvänt, genom att minska eller stoppa SMB om glukosnivåerna sjunker oväntat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It uses the SMB (Super Micro Bolus) algorithm to deliver insulin in small amounts to correct glucose spikes. UAM also works in reverse, reducing or stopping SMBs if glucose levels drop unexpectedly."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовується алгоритм SMB (Super Micro Bolus) для доставки інсуліну в невеликих кількостях, щоб виправити піки глюкози. UAM також працює реверсивно, зменшуючи чи зупиняючи SMB, якщо рівень глюкози несподівано знижується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó sử dụng thuật toán SMB (Super Micro Bolus) để cung cấp insulin với lượng nhỏ để điều chỉnh lượng đường huyết tăng đột biến. UAM cũng hoạt động ngược lại, giảm hoặc dừng SMB nếu lượng đường huyết giảm đột ngột."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它使用SMB（超微量注射）演算法來以小量提供胰島素，以修正葡萄糖尖峰。如果葡萄糖水平意外下降，UAM也會以相反方式運作，減少或停止SMB。"
          }
        }
      }
    },
    "It's designed to keep the important trends in your data while minimizing those small, misleading variations, giving you and Trio a clearer sense of where your blood sugar is really headed. This type of filtering is useful in Trio, as it can help prevent over-corrections based on inaccurate glucose readings. This can help reduce the impact of sudden spikes or dips that might not reflect your true blood glucose levels." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's designed to keep the important trends in your data while minimizing those small, misleading variations, giving you and Trio a clearer sense of where your blood sugar is really headed. This type of filtering is useful in Trio, as it can help prevent over-corrections based on inaccurate glucose readings. This can help reduce the impact of sudden spikes or dips that might not reflect your true blood glucose levels."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er designet til at holde de vigtige tendenser i dine data samtidig minimere de små, vildledende variationer, hvilket giver dig og Trio en klarere fornemmelse af, hvor dit blodsukker virkelig er i gang. Denne type filtrering er nyttig i Trio, da det kan hjælpe med at forhindre over-korrektioner baseret på unøjagtige glukoseaflæsninger. Dette kan medvirke til at nedsætte virkningen af pludselige stigninger eller dipper, som måske ikke afspejler dit sande blodsukkerniveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde entwickelt, um die wichtigen Trends in Deinen Daten zu halten und gleichzeitig irreführende Unregelmäßigkeiten zu minimieren, wodurch Du und Trio einen klareres Bild bekommen, wohin Deine Glukose tatsächlich geht. Diese Art der Filterung ist in Trio nützlich, da sie dazu beitragen kann, übermäßige Korrekturen aufgrund ungenauer Glukosemessungen zu verhindern. Dies kann dazu beitragen, die Auswirkungen von plötzlichen Ausreißern nach oben oder unten zu verringern, die Deinen wahren Glukosespiegel nicht widerspiegeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está diseñado para mantener las tendencias importantes en sus datos al tiempo que minimiza las pequeñas, variaciones engañosas, dándole a usted y a Trio una sensación más clara de hacia dónde se dirige realmente su azúcar en la sangre. Este tipo de filtrado es útil en Trío, ya que puede ayudar a prevenir correcciones excesivas basadas en lecturas de glucosa inexactas. Esto puede ayudar a reducir el impacto de picos repentinos o golpes que pueden no reflejar tus niveles reales de glucosa en la sangre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce filtre est conçu pour conserver les tendances importantes de vos données tout en atténuant les petites variations trompeuses, afin de vous offrir ainsi qu'à Trio une vision plus claire de la trajectoire réelle de votre mesure de glucose.\nCe type de filtrage est utile dans Trio, car il permet d’éviter des corrections excessives basées sur des mesures inexactes.\nIl contribue ainsi à réduire l’impact des hausses ou baisses soudaines qui ne reflètent pas nécessairement votre niveau réel de glucose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's designed to keep the important trends in your data while minimizing those small, misleading variations, giving you and Trio a clearer sense of where your blood sugar is really headed. This type of filtering is useful in Trio, as it can help prevent over-corrections based on inaccurate glucose readings. This can help reduce the impact of sudden spikes or dips that might not reflect your true blood glucose levels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È progettato per mantenere le tendenze importanti nei tuoi dati riducendo al minimo quelle piccole, variazioni ingannevoli, dando a lei e al Trio un senso più chiaro di dove il livello di zucchero nel sangue è veramente diretto. Questo tipo di filtraggio è utile in Trio, in quanto può aiutare a prevenire correzioni eccessive basate su letture inaccurate del glucosio. Questo può contribuire a ridurre l’impatto di picchi o tuffi improvvisi che potrebbero non riflettere i livelli di glucosio nel sangue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's designed to keep the important trends in your data while minimizing those small, misleading variations, giving you and Trio a clearer sense of where your blood sugar is really headed. This type of filtering is useful in Trio, as it can help prevent over-corrections based on inaccurate glucose readings. This can help reduce the impact of sudden spikes or dips that might not reflect your true blood glucose levels."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er designet for å beholde de viktige trendene i dataene dine, samtidig som den minimerer de små, misvisende variasjonene, og gir deg og Trio en klarere følelse av hvor blodsukkeret ditt egentlig er på vei. Denne typen filtrering er nyttig i Trio, da den kan bidra til å forhindre overkorrigeringer basert på unøyaktige blodsukkeravlesninger. Dette kan bidra til å redusere virkningen av plutselige topper eller fall som kanskje ikke gjenspeiler dine faktiske blodsukkernivåer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is ontworpen om de belangrijke trends in je data te bewaren terwijl je die klein beperkt misleidende variaties, die u en Trio een duidelijker gevoel geven van waar uw bloedsuiker echt ligt. Dit filtertype is handig in Trio, omdat het kan helpen overcorrecties op basis van onnauwkeurige glucosewaardes te voorkomen. Dit kan helpen om het effect van plotselinge pieken of bloedglucosewaardes te verminderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Został zaprojektowany, aby zachować ważne trendy w Twoich danych, jednocześnie minimalizując te małe, mylące odchylenia, dając Tobie i Trio jaśniejsze pojęcie, w jakim kierunku naprawdę zmierza Twój poziom cukru we krwi. Ten typ filtrowania jest przydatny w Trio, ponieważ może pomóc zapobiec nadmiernym korektom opartym na niedokładnych odczytach glikemii. Może to pomóc zmniejszyć wpływ nagłych skoków lub spadków, które mogą nie odzwierciedlać Twojego prawdziwego poziomu glikemii we krwi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É projetado para manter as tendências importantes em seus dados ao mesmo tempo em que minimiza aquelas pequenas variações enganosas, dando-lhe a você e a Trio uma noção mais clara de onde o seu açúcar no sangue realmente vai. Este tipo de filtragem é útil em Trio, pois pode ajudar a evitar correções excessivas com base em leituras de glicose imprecisas. Isso pode ajudar a reduzir o impacto de espinhos súbitos ou mergulhos que podem não refletir seus verdadeiros níveis de glicose no sangue."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den är utformad för att behålla de viktiga trenderna i din data samtidigt som den minimerar små, vilseledande variationer, vilket ger dig och Trio en tydligare känsla av vart ditt glukosvärde verkligen är på väg. Denna typ av filtrering är användbar i Trio, eftersom det kan bidra till att förhindra överkorrigeringar baserade på felaktiga glukosavläsningar. Detta kan bidra till att minska effekterna av plötsliga stigningar eller fall som kanske inte speglar din sanna glukosnivå."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's designed to keep the important trends in your data while minimizing those small, misleading variations, giving you and Trio a clearer sense of where your blood sugar is really headed. This type of filtering is useful in Trio, as it can help prevent over-corrections based on inaccurate glucose readings. This can help reduce the impact of sudden spikes or dips that might not reflect your true blood glucose levels."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона покликана зберегти важливі тенденції у ваших даних, при мінімізуючи ці маленькі, оманливі варіації, надаючи вам і Тріо зрозуміліше відчуття, де ваш цукор насправді очолюється. Цей тип фільтрації корисний у Тріо, оскільки він може допомогти запобігти надмірній корекції на основі неточних показників глюкози. Це може допомогти зменшити вплив раптових шипів або копань, які могли б не відображати вашого справжнього рівня глюкози в крові."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó được thiết kế để giữ lại các xu hướng quan trọng trong dữ liệu của bạn trong khi giảm thiểu những biến thể nhỏ, gây hiểu lầm, giúp bạn và Trio hiểu rõ hơn về hướng đi thực sự của lượng đường trong máu. Kiểu lọc này hữu ích trong Trio vì nó có thể giúp ngăn ngừa việc hiệu chỉnh quá mức dựa trên các chỉ số đường huyết không chính xác. Điều này có thể giúp giảm tác động của các đột biến hoặc giảm đột ngột có thể không phản ánh đúng lượng đường trong máu thực sự của bạn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它旨在保持你資料中的重要趨勢，同時最小化那些微小的、誤導性的變化，讓你和Trio對你的血糖走向有更清晰的了解。這種類型的過濾在Trio中非常有用，因為它可以幫助防止基於不準確的葡萄糖讀取值而產生的過度修正。這可以減少突發的尖峰或下降對你真實血糖水平的影響。"
          }
        }
      }
    },
